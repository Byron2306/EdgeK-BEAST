{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Byron2306/EdgeK-BEAST/blob/main/plugins/beast-plugin.schema.json",
  "title": "BEAST Plugin Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["beast_plugin_manifest_version", "id", "name", "version", "publisher", "risk_class", "entrypoint", "tools", "permissions", "budget", "approval_policy"],
  "properties": {
    "beast_plugin_manifest_version": {"const": "1.0"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,79}$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 120},
    "version": {"type": "string", "minLength": 1, "maxLength": 40},
    "publisher": {"type": "string", "minLength": 1, "maxLength": 120},
    "description": {"type": "string", "maxLength": 2000},
    "risk_class": {"enum": ["low", "medium", "high", "critical"]},
    "entrypoint": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {"enum": ["mcp_stdio", "python", "http"]},
        "command": {"type": "string"},
        "args": {"type": "array", "items": {"type": "string"}},
        "module": {"type": "string"},
        "url": {"type": "string"}
      },
      "additionalProperties": false
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "description", "inputSchema", "tool_schema_hash"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "description": {"type": "string"},
          "inputSchema": {"type": "object"},
          "tool_schema_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "permissions": {
      "type": "object",
      "required": ["filesystem_read", "filesystem_write", "network_domains", "environment", "subprocess"],
      "properties": {
        "filesystem_read": {"type": "array", "items": {"type": "string"}},
        "filesystem_write": {"type": "array", "items": {"type": "string"}},
        "network_domains": {"type": "array", "items": {"type": "string"}},
        "environment": {"type": "array", "items": {"type": "string"}},
        "subprocess": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "budget": {
      "type": "object",
      "required": ["max_tokens_per_call", "max_cost_usd_per_call", "max_latency_ms", "calls_per_hour"],
      "properties": {
        "max_tokens_per_call": {"type": "integer", "minimum": 0},
        "max_cost_usd_per_call": {"type": "number", "minimum": 0},
        "max_latency_ms": {"type": "number", "minimum": 0},
        "calls_per_hour": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "approval_policy": {
      "type": "object",
      "required": ["install", "first_run", "network", "external_write", "filesystem_write"],
      "properties": {
        "install": {"type": "boolean"},
        "first_run": {"type": "boolean"},
        "network": {"type": "boolean"},
        "external_write": {"type": "boolean"},
        "filesystem_write": {"type": "boolean"}
      },
      "additionalProperties": false
    }
  }
}
