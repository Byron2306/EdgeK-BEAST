{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/dai-diode/dai-independent-evidence.schema.json",
  "title": "DAI-Diode independent evidence schemas",
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "authorityFalse": {
      "type": "object",
      "required": ["production_authority_allowed", "execution_authority_allowed"],
      "properties": {
        "production_authority_allowed": {"const": false},
        "execution_authority_allowed": {"const": false}
      }
    },
    "signature": {
      "type": "object",
      "required": ["signature_algorithm", "signature_base64", "public_key_path"],
      "properties": {
        "signature_algorithm": {"const": "Ed25519"},
        "signature_base64": {"type": "string", "minLength": 80},
        "public_key_path": {"type": "string", "minLength": 1}
      }
    },
    "rawEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "reproduction": {
      "allOf": [
        {"$ref": "#/$defs/authorityFalse"},
        {"$ref": "#/$defs/signature"},
        {
          "type": "object",
          "required": [
            "schema",
            "operator_id",
            "operator_control_domain",
            "operator_key_fingerprint",
            "subject_core_capsule_sha256",
            "environment_digest",
            "verifier_digest",
            "semantic_result_digest",
            "mutation_report_digest",
            "private_help_received",
            "result"
          ],
          "properties": {
            "schema": {"const": "dai.independent-reproduction.v1"},
            "operator_id": {"type": "string", "minLength": 1},
            "operator_control_domain": {"type": "string", "minLength": 1},
            "operator_key_fingerprint": {"$ref": "#/$defs/sha256"},
            "subject_core_capsule_sha256": {"$ref": "#/$defs/sha256"},
            "environment_digest": {"$ref": "#/$defs/sha256"},
            "verifier_digest": {"$ref": "#/$defs/sha256"},
            "semantic_result_digest": {"$ref": "#/$defs/sha256"},
            "mutation_report_digest": {"$ref": "#/$defs/sha256"},
            "private_help_received": {"const": false},
            "result": {"const": "pass"}
          }
        }
      ]
    },
    "witness": {
      "allOf": [
        {"$ref": "#/$defs/authorityFalse"},
        {"$ref": "#/$defs/signature"},
        {
          "type": "object",
          "required": [
            "schema",
            "operator_id",
            "operator_control_domain",
            "infrastructure_provider",
            "witness_role",
            "signing_key_fingerprint",
            "subject_core_capsule_sha256",
            "proposal_digest",
            "capability_digest",
            "evidence_root",
            "world_state_hash",
            "governance_epoch",
            "challenge_nonce",
            "verifier_digest",
            "raw_attestation_evidence",
            "issued_at",
            "expires_at",
            "decision"
          ],
          "properties": {
            "schema": {"const": "dai.commons-witness-packet.v1"},
            "operator_id": {"type": "string", "minLength": 1},
            "operator_control_domain": {"type": "string", "minLength": 1},
            "infrastructure_provider": {"type": "string", "minLength": 1},
            "witness_role": {"type": "string", "minLength": 1},
            "signing_key_fingerprint": {"$ref": "#/$defs/sha256"},
            "subject_core_capsule_sha256": {"$ref": "#/$defs/sha256"},
            "proposal_digest": {"$ref": "#/$defs/sha256"},
            "capability_digest": {"$ref": "#/$defs/sha256"},
            "evidence_root": {"$ref": "#/$defs/sha256"},
            "world_state_hash": {"$ref": "#/$defs/sha256"},
            "governance_epoch": {"type": ["string", "integer"]},
            "challenge_nonce": {"type": "string", "minLength": 16},
            "verifier_digest": {"$ref": "#/$defs/sha256"},
            "raw_attestation_evidence": {
              "type": "array",
              "minItems": 1,
              "items": {"$ref": "#/$defs/rawEvidence"}
            },
            "issued_at": {"type": "string", "format": "date-time"},
            "expires_at": {"type": "string", "format": "date-time"},
            "decision": {"enum": ["approve", "reject", "abstain"]}
          }
        }
      ]
    },
    "networkWitness": {
      "allOf": [
        {"$ref": "#/$defs/authorityFalse"},
        {"$ref": "#/$defs/signature"},
        {
          "type": "object",
          "required": [
            "schema",
            "observer_operator_id",
            "observer_key_fingerprint",
            "subject_core_capsule_sha256",
            "result",
            "network_policy",
            "observation_sources",
            "observed_outbound_connections",
            "provider_calls_observed",
            "started_at",
            "ended_at"
          ],
          "properties": {
            "schema": {"const": "dai.network-denial-witness.v1"},
            "observer_operator_id": {"type": "string", "minLength": 1},
            "observer_key_fingerprint": {"$ref": "#/$defs/sha256"},
            "subject_core_capsule_sha256": {"$ref": "#/$defs/sha256"},
            "result": {"const": "pass"},
            "provider_calls_observed": {"const": 0},
            "observed_outbound_connections": {"type": "array", "maxItems": 0},
            "started_at": {"type": "string", "format": "date-time"},
            "ended_at": {"type": "string", "format": "date-time"}
          }
        }
      ]
    }
  },
  "oneOf": [
    {"$ref": "#/$defs/reproduction"},
    {"$ref": "#/$defs/witness"},
    {"$ref": "#/$defs/networkWitness"}
  ]
}
