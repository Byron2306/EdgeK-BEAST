# Install as ~/.config/beast/socket-consumer.env with mode 0600.
# This file contains non-secret authority bindings. The generated systemd unit
# loads the bearer token from ~/.config/beast/guardian-authorization.token as a
# systemd credential; never put the token in this environment file.
# The generated unit supplies the control-socket and public-key paths using
# systemd specifiers. For a manual launch, set their absolute paths in the shell.
BEAST_GUARDIAN_AUTHORIZATION_URL=https://arda.test/authorize/socket-guardian
BEAST_GUARDIAN_AUTHORITY=arda
BEAST_GUARDIAN_WORKSPACE_ID=REPLACE_WITH_WORKSPACE_UUID
BEAST_GUARDIAN_POLICY_GENERATION=REPLACE_WITH_POLICY_GENERATION
BEAST_GUARDIAN_APPRAISAL_REF=REPLACE_WITH_ARDA_APPRAISAL_REF
BEAST_GUARDIAN_STARTUP_TIMEOUT=20
