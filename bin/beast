def command_chronicle(args: argparse.Namespace) -> Dict[str, Any]:
    from app.kernel.chronicle_projection import ChronicleProjectionPublisher
    from app.kernel.task_envelope import TaskEnvelopeBuilder

    builder = TaskEnvelopeBuilder()
    if args.publish:
        payload = {
            "task_id": args.task_id,
            "targets": split_items(args.target),
            "approved": bool_value(args.approved),
            "dry_run": bool_value(args.dry_run),
        }

        def local(_exc):
            chronicle = builder.get_chronicle(args.task_id)
            return ChronicleProjectionPublisher().publish(
                chronicle,
                targets=payload["targets"],
                approved=payload["approved"],
                dry_run=payload["dry_run"],
            )

        return {"command": "chronicle", **_gateway_or_local(args, "POST", "/edgek/chronicle/publish", payload, local)}
    if args.task_id:
        def local_detail(_exc):
            return builder.get_chronicle(args.task_id)

        return {"command": "chronicle", **_gateway_or_local(args, "GET", f"/edgek/chronicle/{args.task_id}", None, local_detail)}

    def local_list(_exc):
        return builder.list_chronicles(provider=args.provider, task_class=args.task_class, category=args.category, limit=int(args.limit))

    query = f"/edgek/chronicle?limit={int(args.limit)}"
    if args.provider:
        query += f"&provider={args.provider}"
    if args.task_class:
        query += f"&task_class={args.task_class}"
    if args.category:
        query += f"&category={args.category}"
    return {"command": "chronicle", **_gateway_or_local(args, "GET", query, None, local_list)}


def command_promote(args: argparse.Namespace) -> Dict[str, Any]:
    payload = {
        "candidate_id": args.candidate_id,
        "approved": bool_value(args.approved),
        "insight_packet": read_json_file(args.insight_packet),
    }
    path = "/edgek/skills/promote" if args.candidate_id else "/edgek/skills/promotion-check"

    def local(exc):
        return {
            "beast_object_type": "promotion_cli_result",
            "ready": False,
            "reason": "gateway_required_for_promotion_kernel" if exc else "local_promotion_not_bound",
            "candidate_id": args.candidate_id,
        }

    return {"command": "promote", **_gateway_or_local(args, "POST", path, payload, local)}


def command_prec(args: argparse.Namespace) -> Dict[str, Any]:
    from app.kernel.storage.prec_lifecycle import PRECLifecycleStore

    store = PRECLifecycleStore()
    action = args.prec_action

    if action == "status":
        def local_status(_exc):
            return store.state()

        return {"command": "prec", "action": action, **_gateway_or_local(args, "GET", "/edgek/prec/state", None, local_status)}

    if action == "list":
        query = f"/edgek/prec/lifecycle?limit={int(args.limit)}"
        if args.kind:
            query += f"&kind={args.kind}"
        if args.status:
            query += f"&status={args.status}"

        def local_list(_exc):
            return store.list(kind=args.kind, status=args.status, limit=int(args.limit))

        return {"command": "prec", "action": action, **_gateway_or_local(args, "GET", query, None, local_list)}

    if action == "trace":
        def local_trace(_exc):
            detail = store.get(args.lifecycle_id)
            return detail or {"found": False, "reason": "prec_lifecycle_not_found", "lifecycle_id": args.lifecycle_id}

        return {"command": "prec", "action": action, **_gateway_or_local(args, "GET", f"/edgek/prec/lifecycle/{args.lifecycle_id}", None, local_trace)}

    if action == "snapshot":
        path = f"/edgek/prec/lifecycle/{args.lifecycle_id}/snapshot?max_chars={int(args.max_chars)}&persist={str(bool_value(args.persist)).lower()}"

        def local_snapshot(_exc):
            try:
                return store.compact_snapshot(
                    args.lifecycle_id,
                    max_chars=int(args.max_chars),
                    persist=bool_value(args.persist),
                )
            except ValueError as exc:
                return {"found": False, "reason": str(exc), "lifecycle_id": args.lifecycle_id}

        return {"command": "prec", "action": action, **_gateway_or_local(args, "GET", path, None, local_snapshot)}

    if action == "start":
        payload = {
            "kind": args.kind or "operator_session",
            "objective": args.objective,
            "scope": args.scope or "",
            "task_id": args.task_id,
            "provider": args.provider,
        }

        def local_start(_exc):
            return store.start(
                kind=payload["kind"],
                objective=payload["objective"],
                scope=payload["scope"],
                task_id=payload["task_id"],
                provider=payload["provider"],
            )

        return {"command": "prec", "action": action, **_gateway_or_local(args, "POST", "/edgek/prec/start", payload, local_start)}

    if action == "advance":
        payload = {
            "lifecycle_id": args.lifecycle_id,
            "phase": args.phase,
            "status": args.status or "completed",
            "summary": args.summary or "",
            "artifacts": read_json_file(args.artifacts),
            "signals": split_items(args.signal),
        }

        def local_advance(_exc):
            return store.record_phase(
                payload["lifecycle_id"],
                payload["phase"],
                status=payload["status"],
                summary=payload["summary"],
                artifacts=payload["artifacts"],
                signals=payload["signals"],
            )

        return {"command": "prec", "action": action, **_gateway_or_local(args, "POST", "/edgek/prec/update", payload, local_advance)}

    return {"command": "prec", "action": action, "error": "unsupported_prec_action"}


def current_task_from_args(args: argparse.Namespace) -> Dict[str, Any]:
    current_task = read_json_file(getattr(args, "current_task", None))
    if getattr(args, "objective", None):
        current_task.setdefault("objective", args.objective)
    if getattr(args, "scope", None):
        current_task["scope"] = args.scope
    constraints = split_items(getattr(args, "constraint", None))
    if constraints:
        current_task["constraints"] = constraints
    success = split_items(getattr(args, "success_criteria", None))
    if success:
        current_task["success_criteria"] = success
    return current_task


def local_handoff_prepare(args: argparse.Namespace) -> Dict[str, Any]:
    from app.kernel.insight_compiler import InsightCompiler
    from app.kernel.forensic_memory import ForensicMemory

    return InsightCompiler(forensic_memory=ForensicMemory()).prepare_handoff(
        current_task=current_task_from_args(args),
        objective=getattr(args, "objective", "") or "",
        provider=getattr(args, "provider", None),
        task_class=getattr(args, "task_class", None),
        limit=int(getattr(args, "limit", 8)),
        persist_task=bool_value(getattr(args, "persist_task", "true")),
        **forensic_payload_from_args(args),
    )


def command_handoff_prepare(args: argparse.Namespace) -> Dict[str, Any]:
    payload = {
        "current_task": current_task_from_args(args),
        "objective": args.objective or "",
        "provider": args.provider,
        "task_class": args.task_class,
        "limit": int(args.limit),
        "persist_task": bool_value(args.persist_task),
        **forensic_payload_from_args(args),
    }
    if not args.local_only:
        try:
            return http_json("POST", args.gateway, "/edgek/handoff/prepare", payload, timeout=8.0)
        except (urllib.error.URLError, TimeoutError, OSError, ValueError) as exc:
            local = local_handoff_prepare(args)
            return {**local, "source": "local_fallback", "gateway_error": str(exc)}
    return {**local_handoff_prepare(args), "source": "local"}


