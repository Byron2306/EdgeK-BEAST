def start_mcp_http_server(host: str = "127.0.0.1", port: int = 8001) -> None:
    import uvicorn
    from fastapi import FastAPI
    from app.mcp.server import mcp_router

    app = FastAPI(title="EdgeK BEAST MCP HTTP")
    app.include_router(mcp_router)
    logger.info("Starting EdgeK BEAST MCP HTTP server on %s:%s", host, port)
    uvicorn.run(app, host=host, port=port, log_level="info")


def start_gateway(host: str = "127.0.0.1", port: int = 8000, reload: bool = False) -> None:
    import uvicorn

    uvicorn.run("app.main:app", host=host, port=port, reload=reload, log_level="warning")


def run_dir() -> Path:
    path = ROOT / "deploy" / "run"
    path.mkdir(parents=True, exist_ok=True)
    return path


def generated_dir() -> Path:
    path = ROOT / "deploy" / "generated"
    path.mkdir(parents=True, exist_ok=True)
    return path


def beast_python() -> str:
    for candidate in (ROOT / "venv" / "bin" / "python", ROOT / ".venv" / "bin" / "python"):
        if candidate.exists():
            return str(candidate)
    return sys.executable


def pid_running(pid_file: Path) -> tuple[bool, Optional[int]]:
    if not pid_file.exists():
        return False, None
    try:
        pid = int(pid_file.read_text(encoding="utf-8").strip())
        os.kill(pid, 0)
        return True, pid
    except (OSError, ValueError):
        return False, None


def url_ready(url: str, timeout: float = 1.0) -> bool:
    try:
        urllib.request.urlopen(url, timeout=timeout).read(128)
        return True
    except Exception:
        return False


def wait_url(url: str, timeout_seconds: float = 20.0) -> bool:
    deadline = time.time() + timeout_seconds
    while time.time() < deadline:
        if url_ready(url, timeout=1.0):
            return True
        time.sleep(0.35)
    return url_ready(url, timeout=1.0)


def spawn_daemon(name: str, command: list[str], pid_file: Path, log_file: Path, cwd: Path = ROOT, env: Optional[Dict[str, str]] = None) -> Dict[str, Any]:
    running, pid = pid_running(pid_file)
    if running:
        return {"service": name, "status": "already_running", "pid": pid, "pid_file": str(pid_file), "log_file": str(log_file), "command": " ".join(command)}
    log_file.parent.mkdir(parents=True, exist_ok=True)
    log = log_file.open("ab")
    process = subprocess.Popen(
        command,
        cwd=str(cwd),
        stdout=log,
        stderr=subprocess.STDOUT,
        stdin=subprocess.DEVNULL,
        start_new_session=True,
        env=env or os.environ.copy(),
    )
    pid_file.write_text(str(process.pid), encoding="utf-8")
    return {"service": name, "status": "started", "pid": process.pid, "pid_file": str(pid_file), "log_file": str(log_file), "command": " ".join(command)}


def start_ollama_daemon(host: str = "127.0.0.1:11434") -> Dict[str, Any]:
    if url_ready(f"http://{host}/api/tags"):
        return {"service": "ollama", "status": "already_running", "base_url": f"http://{host}"}
    command = ["ollama", "serve"]
    env = os.environ.copy()
    env.setdefault("OLLAMA_HOST", host)
    result = spawn_daemon("ollama", command, run_dir() / "ollama.pid", run_dir() / "ollama.log", env=env)
    result["ready"] = wait_url(f"http://{host}/api/tags", timeout_seconds=25.0)
    result["base_url"] = f"http://{host}"
    return result


def start_gateway_daemon(host: str, port: int) -> Dict[str, Any]:
    url = f"http://{host}:{port}/health"
    if url_ready(url):
        return {"service": "gateway", "status": "already_running", "base_url": f"http://{host}:{port}", "ready": True}
    command = [beast_python(), str(BEAST), "gateway", "--host", host, "--port", str(port)]
    result = spawn_daemon("gateway", command, run_dir() / "gateway.pid", run_dir() / "gateway.log")
    result["ready"] = wait_url(url, timeout_seconds=35.0)
    result["base_url"] = f"http://{host}:{port}"
    return result


def start_mcp_http_daemon(host: str, port: int) -> Dict[str, Any]:
    url = f"http://{host}:{port}/mcp/health"
    if url_ready(url):
        return {"service": "mcp_http", "status": "already_running", "base_url": f"http://{host}:{port}", "ready": True}
    command = [beast_python(), str(BEAST), "mcp-http", "--host", host, "--port", str(port)]
    result = spawn_daemon("mcp_http", command, run_dir() / "mcp-http.pid", run_dir() / "mcp-http.log")
    result["ready"] = wait_url(url, timeout_seconds=25.0)
    result["base_url"] = f"http://{host}:{port}"
    return result


def start_litellm_daemon(port: int = 4000) -> Dict[str, Any]:
    from app.kernel.reason import reasoner
    from app.kernel.deployment import DeploymentManager

    manager = DeploymentManager(reasoner.policies)
    manager.write_generated_files(generated_dir())
    state = manager.litellm_sidecar_status(pid_file=run_dir() / "litellm.pid", port=port)
    if state.get("running"):
        return {"service": "litellm", "status": "already_running", "ready": True, **state}
    result = manager.start_litellm_sidecar(
        config_path=generated_dir() / "litellm.config.yaml",
        pid_file=run_dir() / "litellm.pid",
        port=port,
        dry_run=False,
        approved=True,
    )
    result["service"] = "litellm"
    result["ready"] = wait_url(f"http://127.0.0.1:{port}/v1/models", timeout_seconds=35.0)
    return result


def ensure_nginx(listen_port: int = 8080, apply: bool = True) -> Dict[str, Any]:
    from app.kernel.reason import reasoner
    from app.kernel.deployment import DeploymentManager

    manager = DeploymentManager(reasoner.policies)
    manager.write_generated_files(generated_dir())
    result: Dict[str, Any] = {"service": "nginx", "generated_config": str(generated_dir() / "nginx.edgek.conf")}
    if not apply:
        return {**result, "status": "generated_only", "ready": url_ready(f"http://127.0.0.1:{listen_port}/health")}
    nginx = shutil_which("nginx")
    if not nginx:
        return {**result, "status": "missing", "ready": False, "error": "nginx executable not found"}
    if pgrep("nginx") and os.geteuid() != 0:
        return {
            **result,
            "status": "already_running_unmanaged",
            "ready": True,
            "warning": "nginx is already running; run with elevated privileges to test/reload the system nginx config",
        }
    test = subprocess.run([nginx, "-t"], capture_output=True, text=True, timeout=15, check=False)
    result["test_returncode"] = test.returncode
    result["test_stderr"] = test.stderr[-1000:]
    if test.returncode != 0:
        if pgrep("nginx"):
            return {
                **result,
                "status": "already_running_unmanaged",
                "ready": True,
                "warning": "nginx is running, but this user could not test/reload the system nginx config",
            }
        return {**result, "status": "config_test_failed", "ready": False}
    if not pgrep("nginx"):
        start = subprocess.run([nginx], capture_output=True, text=True, timeout=15, check=False)
        result["start_returncode"] = start.returncode
        result["start_stderr"] = start.stderr[-1000:]
        status = "started" if start.returncode == 0 else "start_failed"
    else:
        reload_result = subprocess.run([nginx, "-s", "reload"], capture_output=True, text=True, timeout=15, check=False)
        result["reload_returncode"] = reload_result.returncode
        result["reload_stderr"] = reload_result.stderr[-1000:]
        status = "reloaded" if reload_result.returncode == 0 else "reload_failed"
    return {**result, "status": status, "ready": bool(pgrep("nginx"))}


def shutil_which(name: str) -> Optional[str]:
    search_path = os.environ.get("PATH", "")
    for extra in ("/usr/sbin", "/sbin", "/usr/local/sbin"):
        if extra not in search_path.split(os.pathsep):
            search_path += os.pathsep + extra
    for folder in search_path.split(os.pathsep):
        candidate = Path(folder) / name
        if candidate.exists() and os.access(candidate, os.X_OK):
            return str(candidate)
    return None


def pgrep(pattern: str) -> list[int]:
    completed = subprocess.run(["pgrep", "-f", pattern], capture_output=True, text=True, check=False)
    pids = []
    for line in completed.stdout.splitlines():
        try:
            pid = int(line.strip())
            if pid != os.getpid():
                pids.append(pid)
        except ValueError:
            pass
    return pids


def http_json(method: str, gateway: str, path: str, payload: Optional[Dict[str, Any]] = None, timeout: float = 2.0) -> Dict[str, Any]:
    url = gateway.rstrip("/") + path
    data = None
    headers = {"Accept": "application/json"}
    if payload is not None:
        data = json.dumps(payload).encode("utf-8")
        headers["Content-Type"] = "application/json"
    request = urllib.request.Request(url, data=data, headers=headers, method=method.upper())
    with urllib.request.urlopen(request, timeout=timeout) as response:
        body = response.read().decode("utf-8")
        return json.loads(body) if body else {}


def gateway_probe(gateway: str, path: str, timeout: float = 1.0) -> Dict[str, Any]:
    try:
        return {"ok": True, "path": path, "payload": http_json("GET", gateway, path, timeout=timeout)}
    except Exception as exc:
        return {"ok": False, "path": path, "error": str(exc)}


def emit(payload: Dict[str, Any], agent: bool, human: Optional[str] = None) -> None:
    if agent:
        print(json.dumps(payload, sort_keys=True))
    else:
        print(human or json.dumps(payload, indent=2, sort_keys=True))


def bool_value(value: str) -> bool:
    return str(value).strip().lower() not in {"0", "false", "no", "off"}


def read_json_file(path: Optional[str]) -> Dict[str, Any]:
    if not path:
        return {}
    with open(path, "r", encoding="utf-8") as handle:
        return json.load(handle)


def split_items(values: Optional[list[str]]) -> list[str]:
    items: list[str] = []
    for value in values or []:
        for part in str(value).split(","):
            cleaned = part.strip()
            if cleaned:
                items.append(cleaned)
    return items


def forensic_payload_from_args(args: argparse.Namespace) -> Dict[str, Any]:
    return {
        "include_forensic_context": bool_value(getattr(args, "include_forensic_context", "true")),
        "forensic_limit": int(getattr(args, "forensic_limit", 8)),
        "forensic_layer": getattr(args, "forensic_layer", None),
        "forensic_event_kind": getattr(args, "forensic_event_kind", None),
        "forensic_provider": getattr(args, "forensic_provider", None),
        "forensic_status": getattr(args, "forensic_status", None),
    }


def scout_options_from_args(args: argparse.Namespace) -> Dict[str, Any]:
    options = {
        "context_limit": int(getattr(args, "context_limit", 6)),
        "tool_limit": int(getattr(args, "tool_limit", 6)),
        "include_postgres_schema": bool_value(getattr(args, "include_postgres_schema", "false")),
        "include_github_context": bool_value(getattr(args, "include_github_context", "false")),
    }
    options.update(forensic_payload_from_args(args))
    return options


def add_forensic_args(parser: argparse.ArgumentParser) -> None:
    parser.add_argument("--include-forensic-context", default="true", help="true/false")
    parser.add_argument("--forensic-limit", type=int, default=8, help="Bounded L4 forensic result limit")
    parser.add_argument("--forensic-layer", choices=["L1", "L2", "L3", "L4"], help="Filter forensic context by interception layer")
    parser.add_argument("--forensic-event-kind", help="Filter forensic context by event kind")
    parser.add_argument("--forensic-provider", help="Filter forensic context by provider")
    parser.add_argument("--forensic-status", help="Filter forensic context by status")


