        except (urllib.error.URLError, TimeoutError, OSError, ValueError) as exc:
            local = local_scout(args)
            return {"command": "scout", "source": "local_fallback", "gateway_error": str(exc), **local}
    return {"command": "scout", "source": "local", **local_scout(args)}


def command_mcp_config(args: argparse.Namespace) -> Dict[str, Any]:
    workspace = str(Path(args.workspace or os.environ.get("BEAST_WORKSPACE") or ROOT).resolve())
    gateway = discover_desktop_gateway()
    config = {
        "servers": {
            "edgek-beast": {
                "type": "stdio",
                "command": str(BEAST),
                "args": ["mcp", "--workspace", workspace],
                "env": {
                    "BEAST_WORKSPACE": workspace,
                    "BEAST_ACTIVE_WORKSPACE": workspace,
                    "BEAST_CONTEXT_WORKSPACE": workspace,
                    "BEAST_GATEWAY_URL": gateway,
                },
            }
        }
    }
    return {"command": "mcp-config", "workspace": workspace, "gateway": gateway, "config": config}


def command_mcp_install(args: argparse.Namespace) -> Dict[str, Any]:
    workspace = Path(args.workspace or os.environ.get("BEAST_WORKSPACE") or ROOT).resolve()
    config = command_mcp_config(args)["config"]
    target = workspace / ".vscode" / "mcp.json"
    target.parent.mkdir(parents=True, exist_ok=True)
    existing: Dict[str, Any] = {}
    if target.exists():
        existing = json.loads(target.read_text(encoding="utf-8"))
    existing.setdefault("servers", {}).update(config["servers"])
    target.write_text(json.dumps(existing, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    return {"command": "mcp-install", "installed": True, "path": str(target), "config": existing}


def latest_vsix() -> Optional[Path]:
    extension_dir = ROOT / "vscode-extension"
    versions = sorted(extension_dir.glob("edgek-beast-*.vsix"), key=lambda path: path.stat().st_mtime, reverse=True)
    return versions[0] if versions else None


def command_reinstall_surfaces(args: argparse.Namespace) -> Dict[str, Any]:
    """Refresh local MCP, plugin, and extension integration surfaces."""
    workspace = Path(args.workspace or os.environ.get("BEAST_WORKSPACE") or ROOT).resolve()
    results: Dict[str, Any] = {"command": "reinstall-surfaces", "workspace": str(workspace)}
    mcp_server = command_mcp_config(argparse.Namespace(workspace=str(workspace)))["config"]["servers"]["edgek-beast"]

    if bool_value(getattr(args, "install_workspace_mcp", "false")):
        mcp_args = argparse.Namespace(workspace=str(workspace))
        results["vscode_mcp"] = command_mcp_install(mcp_args)
    else:
        results["vscode_mcp"] = {
            "installed": False,
            "skipped": True,
            "reason": "VS Code extension MCP provider is canonical; pass --install-workspace-mcp true for a file-based fallback.",
        }

    cursor_target = workspace / "integrations" / "mcp-clients" / "cursor" / "mcp.json"
    cursor_target.parent.mkdir(parents=True, exist_ok=True)
    cursor_config = {
        "mcpServers": {
            "edgek-beast": mcp_server
        }
    }
    cursor_target.write_text(json.dumps(cursor_config, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    results["cursor_mcp_template"] = {"installed": True, "path": str(cursor_target), "config": cursor_config}

    claude_target = workspace / "integrations" / "mcp-clients" / "claude-code" / "edgek-beast.mcp.json"
    claude_target.parent.mkdir(parents=True, exist_ok=True)
    claude_config = dict(mcp_server)
    claude_target.write_text(json.dumps(claude_config, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    results["claude_mcp_template"] = {"installed": True, "path": str(claude_target), "config": claude_config}

    client_install = {"requested": bool_value(getattr(args, "install_client_mcp", "true"))}
    if client_install["requested"]:
        cursor_workspace_target = workspace / ".cursor" / "mcp.json"
        cursor_workspace_target.parent.mkdir(parents=True, exist_ok=True)
        existing_cursor: Dict[str, Any] = {}
        if cursor_workspace_target.exists():
            try:
                existing_cursor = json.loads(cursor_workspace_target.read_text(encoding="utf-8"))
            except json.JSONDecodeError:
                existing_cursor = {}
        existing_cursor.setdefault("mcpServers", {})["edgek-beast"] = mcp_server
        cursor_workspace_target.write_text(json.dumps(existing_cursor, indent=2, sort_keys=True) + "\n", encoding="utf-8")
        client_install["cursor_workspace"] = {"installed": True, "path": str(cursor_workspace_target)}

        claude_bin = shutil_which("claude")
        if claude_bin:
            completed = subprocess.run(
                [claude_bin, "mcp", "add-json", "edgek-beast", json.dumps(claude_config, sort_keys=True), "--scope", "project"],
                cwd=str(workspace),
                capture_output=True,
                text=True,
                timeout=30,
                check=False,
            )
            already_exists = "already exists" in ((completed.stderr or "") + (completed.stdout or "")).lower()
            client_install["claude_code"] = {
                "installed": completed.returncode == 0 or already_exists,
                "already_exists": already_exists,
                "returncode": completed.returncode,
                "stdout": completed.stdout[-1200:],
                "stderr": completed.stderr[-1200:],
            }
        else:
            client_install["claude_code"] = {"installed": False, "reason": "claude executable not found"}

        cline_targets = [
            Path.home() / ".config" / "Code" / "User" / "globalStorage" / "saoudrizwan.claude-dev" / "settings" / "cline_mcp_settings.json",
            Path.home() / ".config" / "Code" / "User" / "globalStorage" / "xline.agent-lab" / "settings" / "cline_mcp_settings.json",
            Path.home() / ".config" / "Code" / "User" / "globalStorage" / "sixth.sixth-ai" / "settings" / "sixth-mcp-settings.json",
        ]
        cline_results = []
        for target in cline_targets:
            if not target.exists():
                continue
            try:
                current = json.loads(target.read_text(encoding="utf-8"))
            except json.JSONDecodeError:
                current = {}
            current.setdefault("mcpServers", {})["edgek-beast"] = {
                **mcp_server,
                "disabled": False,
                "autoApprove": [],
            }
            target.write_text(json.dumps(current, indent=2, sort_keys=True) + "\n", encoding="utf-8")
            cline_results.append({"installed": True, "path": str(target)})
        client_install["cline_compatible"] = cline_results
    results["client_mcp"] = client_install

    from app.kernel.deployment.plugin_marketplace import PluginMarketplace

    marketplace = PluginMarketplace(str(workspace / ".beast" / "plugins"))
    plugin_results = []
    for manifest_path in sorted((workspace / "plugins" / "examples").glob("*.beast-plugin.json")):
        try:
            manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
            plugin_results.append(marketplace.install(manifest, approved=True, dry_run=False))
        except Exception as exc:
            plugin_results.append({"installed": False, "path": str(manifest_path), "error": str(exc)})
    results["plugins"] = {
        "installed_count": sum(1 for item in plugin_results if item.get("installed")),
        "results": plugin_results,
        "inventory": marketplace.list_installed(),
    }

    vsix = latest_vsix()
    extension_result: Dict[str, Any] = {
        "latest_vsix": str(vsix) if vsix else "",
        "installed": False,
        "reason": "VS Code install not requested; pass --install-vscode-extension true to run code --install-extension.",
    }
    if bool_value(getattr(args, "install_vscode_extension", "false")):
        if not vsix:
            extension_result["reason"] = "No edgek-beast-*.vsix package found."
        else:
            completed = subprocess.run(
                ["code", "--install-extension", str(vsix), "--force"],
                cwd=str(workspace),
                capture_output=True,
                text=True,
                timeout=45,
                check=False,
            )
            extension_result.update({
                "installed": completed.returncode == 0,
                "returncode": completed.returncode,
                "stdout": completed.stdout[-1200:],
                "stderr": completed.stderr[-1200:],
                "reason": "installed" if completed.returncode == 0 else "code --install-extension failed",
            })
    results["vscode_extension"] = extension_result
    return results


