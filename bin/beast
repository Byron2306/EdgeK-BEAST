def _bootstrap_tui_runtime() -> None:
    """Run the interactive console in the project runtime, not PATH Python.

    ``bin/beast`` is commonly symlinked into ``~/.local/bin``.  Its env
    shebang then follows whatever Python happens to lead PATH (often a conda
    or tool-specific interpreter without PyYAML/Textual).  The TUI has a real
    project runtime, so re-exec it before importing any BEAST modules.
    """
    # Do not trust a marker inherited from a terminal or parent process.  The
    # interpreter identity check below is loop-safe and is the authoritative
    # signal that we are already inside the project runtime.
    if "ui" not in sys.argv[1:]:
        return
    candidates = [
        ROOT / "venv" / "bin" / "python",
        ROOT / ".venv" / "bin" / "python",
        Path(os.environ["BEAST_PYTHON"]) if os.environ.get("BEAST_PYTHON") else None,
    ]
    current_prefix = Path(sys.prefix).expanduser().absolute()
    for candidate in candidates:
        if not candidate or not candidate.exists():
            continue
        # Do not resolve the venv launcher symlink: Python uses that path to
        # locate pyvenv.cfg and its site-packages. Resolving it jumps straight
        # to the base interpreter and reintroduces missing-package failures.
        # ``venv/bin/python`` is normally a symlink to the system
        # interpreter, so ``samefile`` is *not* a valid test here: it would
        # incorrectly say that a system Python already has the venv's
        # dependencies.  Python exposes the active environment through
        # sys.prefix; that is the identity we need to compare.
        candidate_prefix = candidate.parent.parent.absolute()
        if candidate_prefix == current_prefix:
            return
        env = os.environ.copy()
        env["BEAST_TUI_RUNTIME_READY"] = "1"
        os.execve(str(candidate), [str(candidate), str(BEAST), *sys.argv[1:]], env)


_bootstrap_tui_runtime()

# Server commands import ``app.main`` (or ``app.commons_main``), which owns
# service construction.  Initialising the factory here as well can contend
# with the gateway's durable stores before Uvicorn has started, leaving a
# desktop-managed gateway alive but not listening.  Keep eager setup for CLI
# commands that need it, but let server processes initialise once in-app.
_command_name = sys.argv[1] if len(sys.argv) > 1 else ""
_lightweight_verify = _command_name == "verify" and len(sys.argv) > 2 and sys.argv[2] == "release-contract"
if _command_name not in {"crystal-proof", "gateway", "commons-gateway", "mcp-http"} and not _lightweight_verify:
    with contextlib.redirect_stdout(sys.stderr):
        from app.kernel.compute.factory import ServiceFactory
        ServiceFactory.initialize()

