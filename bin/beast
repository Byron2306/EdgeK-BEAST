def discover_desktop_gateway(preferred: str = "") -> str:
    """Return a live BEAST desktop-contract gateway without trusting stale ports.

    The desktop may select 8102+ when Socket Guardian owns 8101.  CLI, TUI,
    and stdio MCP processes must follow that selected local route instead of
    retaining the old 8000 default or failing after a desktop recovery.
    """
    candidates = []
    for value in (preferred, os.environ.get("BEAST_GATEWAY_URL", ""), DEFAULT_GATEWAY):
        value = str(value or "").rstrip("/")
        if value and value not in candidates:
            candidates.append(value)
    for port in range(8101, 8107):
        candidate = f"http://127.0.0.1:{port}"
        if candidate not in candidates:
            candidates.append(candidate)
    for candidate in candidates:
        try:
            request = urllib.request.Request(f"{candidate}/edgek/control-plane/desktop-compatibility", method="GET")
            with urllib.request.urlopen(request, timeout=0.65) as response:
                payload = json.loads(response.read().decode("utf-8"))
            if response.status < 400 and payload.get("status") == "ready":
                return candidate
        except (urllib.error.URLError, TimeoutError, OSError, ValueError, json.JSONDecodeError):
            continue
    return str(preferred or DEFAULT_GATEWAY).rstrip("/")


def start_mcp_http_server(host: str = "127.0.0.1", port: int = 8765) -> None:
    import uvicorn
    from fastapi import FastAPI
    from app.mcp.server import mcp_router

    app = FastAPI(title="EdgeK BEAST MCP HTTP")
    app.include_router(mcp_router)
    logger.info("Starting EdgeK BEAST MCP HTTP server on %s:%s", host, port)
    uvicorn.run(app, host=host, port=port, log_level="info")


def start_gateway(host: str = "127.0.0.1", port: int = 8101, reload: bool = False,
                  socket_mode: str = "direct", guardian_service: str = "beast") -> None:
    import uvicorn
    if socket_mode == "guardian":
        if reload:
            raise RuntimeError("Guardian socket mode forbids Uvicorn reload subprocesses")
        from app.kernel.execution.guardian_uvicorn import run_uvicorn_from_environment
        run_uvicorn_from_environment("app.main:app", service_id=guardian_service, log_level="warning")
        return
    if socket_mode != "direct":
        raise ValueError("socket_mode must be direct or guardian")
    uvicorn.run("app.main:app", host=host, port=port, reload=reload, log_level="warning")


def start_commons_gateway(host: str = "127.0.0.1", port: int = 8601,
                          socket_mode: str = "direct") -> None:
    import uvicorn
    if socket_mode == "guardian":
        from app.kernel.execution.guardian_uvicorn import run_uvicorn_from_environment
        run_uvicorn_from_environment("app.commons_main:app", service_id="commons", log_level="warning")
        return
    if socket_mode != "direct":
        raise ValueError("socket_mode must be direct or guardian")
    uvicorn.run("app.commons_main:app", host=host, port=port, log_level="warning")


def run_dir() -> Path:
    path = ROOT / "deploy" / "run"
    path.mkdir(parents=True, exist_ok=True)
    return path


def generated_dir() -> Path:
    path = ROOT / "deploy" / "generated"
    path.mkdir(parents=True, exist_ok=True)
    return path


def beast_python() -> str:
    for candidate in (ROOT / "venv" / "bin" / "python", ROOT / ".venv" / "bin" / "python"):
        if candidate.exists():
            return str(candidate)
    return sys.executable


def pid_running(pid_file: Path, service: Optional[str] = None) -> tuple[bool, Optional[int]]:
    if not pid_file.exists():
        return False, None
    try:
        pid = int(pid_file.read_text(encoding="utf-8").strip())
        os.kill(pid, 0)
        if service:
            expected = {
                "gateway": ("bin/beast", "gateway"),
                "mcp_http": ("bin/beast", "mcp-http"),
                "litellm": ("litellm",),
                "ollama": ("ollama", "serve"),
            }.get(service)
            if expected:
                try:
                    command = (Path("/proc") / str(pid) / "cmdline").read_bytes().replace(b"\0", b" ").decode("utf-8", errors="replace")
                except OSError:
                    return False, None
                if not all(token in command for token in expected):
                    return False, None
        return True, pid
    except (OSError, ValueError):
        return False, None


def url_ready(url: str, timeout: float = 1.0) -> bool:
    try:
        urllib.request.urlopen(url, timeout=timeout).read(128)
        return True
    except Exception:
        return False


def gateway_routes_ready(base_url: str, timeout: float = 2.0) -> tuple[bool, list[str]]:
    """Check that the running gateway is this source tree's operator surface."""
    declared_required = [
        "/edgek/root-info",
        "/edgek/workspace/files",
        "/edgek/workspace/file",
        "/edgek/ide/snapshot",
        "/edgek/ide/actions/manifest",
        "/edgek/ide/tooling-snapshot",
        "/edgek/ide/system-snapshot",
        "/edgek/session/handshake",
        "/edgek/meta-tool-commons",
        "/edgek/meta-tool-commons/rank",
        "/edgek/tool-laziness/recommend-tools",
        "/edgek/provider-economist/select",
        "/edgek/connectors/otel",
        "/edgek/capability-exchange",
        "/edgek/plugins",
        "/edgek/compute",
        "/edgek/swarm/state",
        "/edgek/prec/state",
    ]
    root_param = urllib.parse.quote(str(ROOT), safe="")
    active_required = [
        "/edgek/root-info",
        f"/edgek/ide/snapshot?root_path={root_param}&objective=gateway-ready",
        "/edgek/ide/actions/manifest",
        f"/edgek/ide/tooling-snapshot?root_path={root_param}",
        f"/edgek/ide/system-snapshot?root_path={root_param}&port_limit=5&process_limit=5",
        "/edgek/mcp/state",
        "/edgek/plugins",
        "/edgek/swarm/state",
        "/edgek/prec/state",
    ]
    try:
        with urllib.request.urlopen(f"{base_url.rstrip('/')}/edgek/root-info", timeout=timeout) as response:
            payload = json.loads(response.read().decode("utf-8"))
        endpoints = payload.get("endpoints") if isinstance(payload, dict) else {}
        endpoint_paths = {value for value in endpoints.values() if isinstance(value, str)}
        declared_missing = [path for path in declared_required if path not in endpoint_paths]
    except Exception:
        declared_missing = declared_required[:]
    missing: list[str] = []
    for route in active_required:
        try:
            with urllib.request.urlopen(f"{base_url.rstrip('/')}{route}", timeout=timeout) as response:
                if response.status >= 400:
                    missing.append(route)
        except Exception:
            missing.append(route)
    if not missing:
        return True, []
    if len(missing) < len(active_required):
        return False, missing
    try:
        with urllib.request.urlopen(f"{base_url.rstrip('/')}/openapi.json", timeout=timeout) as response:
            payload = json.loads(response.read().decode("utf-8"))
    except Exception:
        return False, missing
    paths = payload.get("paths") if isinstance(payload, dict) else {}
    openapi_missing = [path for path in declared_required if path not in paths]
    return False, missing + openapi_missing


def stop_managed_process(pid_file: Path, service: str, timeout_seconds: float = 6.0) -> Dict[str, Any]:
    running, pid = pid_running(pid_file, service)
    if not running or pid is None:
        pid_file.unlink(missing_ok=True)
        return {"service": service, "status": "not_running", "pid_file": str(pid_file)}
    try:
        os.kill(pid, signal.SIGTERM)
    except OSError as exc:
        return {"service": service, "status": "stop_failed", "pid": pid, "error": str(exc)}
    deadline = time.time() + timeout_seconds
    while time.time() < deadline:
        try:
            os.kill(pid, 0)
        except OSError:
            break
        time.sleep(0.2)
    try:
        os.kill(pid, 0)
        os.kill(pid, signal.SIGKILL)
    except OSError:
        pass
    try:
        pid_file.unlink(missing_ok=True)
    except Exception:
        pass
    return {"service": service, "status": "stopped", "pid": pid, "pid_file": str(pid_file)}


def wait_url(url: str, timeout_seconds: float = 20.0) -> bool:
    deadline = time.time() + timeout_seconds
    while time.time() < deadline:
        if url_ready(url, timeout=1.0):
            return True
        time.sleep(0.35)
    return url_ready(url, timeout=1.0)


def spawn_daemon(name: str, command: list[str], pid_file: Path, log_file: Path, cwd: Path = ROOT, env: Optional[Dict[str, str]] = None) -> Dict[str, Any]:
    running, pid = pid_running(pid_file, name)
    if not running:
        pid_file.unlink(missing_ok=True)
    if running:
        return {"service": name, "status": "already_running", "pid": pid, "pid_file": str(pid_file), "log_file": str(log_file), "command": " ".join(command)}
    log_file.parent.mkdir(parents=True, exist_ok=True)
    log = log_file.open("ab")
    process = subprocess.Popen(
        command,
        cwd=str(cwd),
        stdout=log,
        stderr=subprocess.STDOUT,
        stdin=subprocess.DEVNULL,
        start_new_session=True,
        env=env or os.environ.copy(),
    )
    pid_file.write_text(str(process.pid), encoding="utf-8")
    return {"service": name, "status": "started", "pid": process.pid, "pid_file": str(pid_file), "log_file": str(log_file), "command": " ".join(command)}


def start_ollama_daemon(host: str = "127.0.0.1:11434") -> Dict[str, Any]:
    if url_ready(f"http://{host}/api/tags"):
        return {"service": "ollama", "status": "already_running", "base_url": f"http://{host}"}
    command = ["ollama", "serve"]
    env = os.environ.copy()
    env.setdefault("OLLAMA_HOST", host)
    result = spawn_daemon("ollama", command, run_dir() / "ollama.pid", run_dir() / "ollama.log", env=env)
    result["ready"] = wait_url(f"http://{host}/api/tags", timeout_seconds=25.0)
    result["base_url"] = f"http://{host}"
    return result


def start_gateway_daemon(host: str, port: int) -> Dict[str, Any]:
    base_url = f"http://{host}:{port}"
    url = f"{base_url}/health"
    if url_ready(url):
        routes_ok, missing = gateway_routes_ready(base_url)
        if routes_ok:
            return {"service": "gateway", "status": "already_running", "base_url": base_url, "ready": True, "route_check": "ok"}
        stop = stop_managed_process(run_dir() / "gateway.pid", "gateway")
        if url_ready(url):
            return {
                "service": "gateway",
                "status": "stale_unmanaged_gateway_on_port",
                "base_url": base_url,
                "ready": False,
                "missing_routes": missing,
                "stop": stop,
                "recommendation": f"Stop the process bound to {base_url}, then rerun `beast up`.",
            }
    command = [beast_python(), str(BEAST), "gateway", "--host", host, "--port", str(port)]
    result = spawn_daemon("gateway", command, run_dir() / "gateway.pid", run_dir() / "gateway.log")
    result["ready"] = wait_url(url, timeout_seconds=35.0)
    routes_ok, missing = gateway_routes_ready(base_url)
    result["route_check"] = "ok" if routes_ok else "missing"
    if missing:
        result["missing_routes"] = missing
        result["ready"] = False
    result["base_url"] = base_url
    return result


def start_mcp_http_daemon(host: str, port: int) -> Dict[str, Any]:
    url = f"http://{host}:{port}/mcp/health"
    if url_ready(url):
        return {"service": "mcp_http", "status": "already_running", "base_url": f"http://{host}:{port}", "ready": True}
    command = [beast_python(), str(BEAST), "mcp-http", "--host", host, "--port", str(port)]
    result = spawn_daemon("mcp_http", command, run_dir() / "mcp-http.pid", run_dir() / "mcp-http.log")
    result["ready"] = wait_url(url, timeout_seconds=25.0)
    result["base_url"] = f"http://{host}:{port}"
    return result


def start_litellm_daemon(port: int = 4000) -> Dict[str, Any]:
    from app.kernel.governance.reason import reasoner
    from app.kernel.deployment import DeploymentManager

    manager = DeploymentManager(reasoner.policies)
    manager.write_generated_files(generated_dir())
    state = manager.litellm_sidecar_status(pid_file=run_dir() / "litellm.pid", port=port)
    if state.get("running"):
        return {"service": "litellm", "status": "already_running", "ready": True, **state}
    result = manager.start_litellm_sidecar(
        config_path=generated_dir() / "litellm.config.yaml",
        pid_file=run_dir() / "litellm.pid",
        port=port,
        dry_run=False,
        approved=True,
    )
    result["service"] = "litellm"
    result["ready"] = wait_url(f"http://127.0.0.1:{port}/v1/models", timeout_seconds=35.0)
    return result


def ensure_nginx(listen_port: int = 8080, apply: bool = True) -> Dict[str, Any]:
    from app.kernel.governance.reason import reasoner
    from app.kernel.deployment import DeploymentManager

    manager = DeploymentManager(reasoner.policies)
    manager.write_generated_files(generated_dir())
    result: Dict[str, Any] = {"service": "nginx", "generated_config": str(generated_dir() / "nginx.edgek.conf")}
    if not apply:
        return {**result, "status": "generated_only", "ready": url_ready(f"http://127.0.0.1:{listen_port}/health")}
    nginx = shutil_which("nginx")
    if not nginx:
        return {**result, "status": "missing", "ready": False, "error": "nginx executable not found"}
    if pgrep("nginx") and os.geteuid() != 0:
        ready = url_ready(f"http://127.0.0.1:{listen_port}/health")
        return {
            **result,
            "status": "already_running_unmanaged",
            "ready": ready,
            "warning": "nginx is already running; run with elevated privileges to test/reload the system nginx config" if ready else "nginx is running but is not serving the BEAST health route; run with elevated privileges to install/reload the generated config",
        }
    test = subprocess.run([nginx, "-t"], capture_output=True, text=True, timeout=15, check=False)
    result["test_returncode"] = test.returncode
    result["test_stderr"] = test.stderr[-1000:]
    if test.returncode != 0:
        if pgrep("nginx"):
            ready = url_ready(f"http://127.0.0.1:{listen_port}/health")
            return {
                **result,
                "status": "already_running_unmanaged",
                "ready": ready,
                "warning": "nginx is running, but this user could not test/reload the system nginx config" if ready else "nginx is running but is not serving the BEAST health route; run with elevated privileges to test/reload the generated config",
            }
        return {**result, "status": "config_test_failed", "ready": False}
    if not pgrep("nginx"):
        start = subprocess.run([nginx], capture_output=True, text=True, timeout=15, check=False)
        result["start_returncode"] = start.returncode
        result["start_stderr"] = start.stderr[-1000:]
        status = "started" if start.returncode == 0 else "start_failed"
    else:
        reload_result = subprocess.run([nginx, "-s", "reload"], capture_output=True, text=True, timeout=15, check=False)
        result["reload_returncode"] = reload_result.returncode
        result["reload_stderr"] = reload_result.stderr[-1000:]
        status = "reloaded" if reload_result.returncode == 0 else "reload_failed"
    return {**result, "status": status, "ready": url_ready(f"http://127.0.0.1:{listen_port}/health")}


def shutil_which(name: str) -> Optional[str]:
    search_path = os.environ.get("PATH", "")
    for extra in ("/usr/sbin", "/sbin", "/usr/local/sbin"):
        if extra not in search_path.split(os.pathsep):
            search_path += os.pathsep + extra
    for folder in search_path.split(os.pathsep):
        candidate = Path(folder) / name
        if candidate.exists() and os.access(candidate, os.X_OK):
            return str(candidate)
    return None


def pgrep(pattern: str) -> list[int]:
    completed = subprocess.run(["pgrep", "-f", pattern], capture_output=True, text=True, check=False)
    pids = []
    for line in completed.stdout.splitlines():
        try:
            pid = int(line.strip())
            if pid != os.getpid():
                pids.append(pid)
        except ValueError:
            pass
    return pids


def parse_host_port(value: str, default_port: int) -> tuple[str, int]:
    raw = str(value or "").strip()
    if "://" in raw:
        raw = raw.split("://", 1)[1]
    raw = raw.split("/", 1)[0]
    if raw.startswith("[") and "]" in raw:
        host, _, tail = raw[1:].partition("]")
        port = tail[1:] if tail.startswith(":") else str(default_port)
        return host or "127.0.0.1", int(port)
    if ":" in raw:
        host, port = raw.rsplit(":", 1)
        return host or "127.0.0.1", int(port)
    return raw or "127.0.0.1", int(default_port)


def registry_service_port(service_name: str, fallback: int) -> int:
    """Read the workspace service-registry port without requiring PyYAML."""
    try:
        lines = (ROOT / ".byron" / "services.yaml").read_text(encoding="utf-8").splitlines()
    except OSError:
        return fallback
    current = ""
    for line in lines:
        stripped = line.strip()
        if not stripped or stripped.startswith("#"):
            continue
        if line.startswith("  ") and not line.startswith("    ") and stripped.endswith(":"):
            current = stripped[:-1]
            continue
        if current == service_name and stripped.startswith("port:"):
            try:
                port = int(stripped.split(":", 1)[1].strip())
                return port if 1 <= port <= 65535 else fallback
            except ValueError:
                return fallback
    return fallback


def listening_pids_on_port(port: int) -> list[int]:
    pids: set[int] = set()
    commands = [
        ["ss", "-ltnp", f"sport = :{int(port)}"],
        ["lsof", f"-iTCP:{int(port)}", "-sTCP:LISTEN", "-P", "-n", "-t"],
    ]
    for command in commands:
        try:
            completed = subprocess.run(command, capture_output=True, text=True, timeout=4, check=False)
        except (OSError, subprocess.TimeoutExpired):
            continue
        text = (completed.stdout or "") + "\n" + (completed.stderr or "")
        if command[0] == "lsof":
            for line in text.splitlines():
                try:
                    pids.add(int(line.strip()))
                except ValueError:
                    pass
            continue
        for match in re_findall_pid(text):
            pids.add(match)
    return sorted(pid for pid in pids if pid > 1 and pid != os.getpid())


def re_findall_pid(text: str) -> list[int]:
    import re

    found: list[int] = []
    for pattern in (r"pid=(\d+)", r",pid=(\d+),", r"users:\(\(\"[^\"]+\",pid=(\d+)"):
        for match in re.findall(pattern, text or ""):
            try:
                found.append(int(match))
            except ValueError:
                pass
    return found


def kill_pids(pids: list[int], timeout_seconds: float = 5.0) -> Dict[str, Any]:
    unique = sorted({pid for pid in pids if pid > 1 and pid != os.getpid()})
    result: Dict[str, Any] = {"pids": unique, "terminated": [], "killed": [], "missing": [], "errors": []}
    for pid in unique:
        try:
            os.kill(pid, signal.SIGTERM)
            result["terminated"].append(pid)
        except ProcessLookupError:
            result["missing"].append(pid)
        except OSError as exc:
            result["errors"].append({"pid": pid, "error": str(exc)})
    deadline = time.time() + timeout_seconds
    while time.time() < deadline:
        alive = []
        for pid in unique:
            try:
                os.kill(pid, 0)
                alive.append(pid)
            except OSError:
                pass
        if not alive:
            break
        time.sleep(0.2)
    for pid in unique:
        try:
            os.kill(pid, 0)
        except OSError:
            continue
        try:
            os.kill(pid, signal.SIGKILL)
            result["killed"].append(pid)
        except OSError as exc:
            result["errors"].append({"pid": pid, "error": str(exc)})
    return result


def kill_listeners_on_port(service: str, host: str, port: int, dry_run: bool = False) -> Dict[str, Any]:
    pids = listening_pids_on_port(port)
    payload: Dict[str, Any] = {
        "service": service,
        "address": f"{host}:{int(port)}",
        "port": int(port),
        "pids": pids,
    }
    if dry_run:
        return {**payload, "status": "would_kill" if pids else "would_check_no_listener"}
    if not pids:
        return {**payload, "status": "no_listener"}
    killed = kill_pids(pids)
    return {**payload, "status": "killed_address_pids", "kill": killed}


def http_json(method: str, gateway: str, path: str, payload: Optional[Dict[str, Any]] = None, timeout: float = 2.0) -> Dict[str, Any]:
    url = gateway.rstrip("/") + path
    data = None
    headers = {"Accept": "application/json"}
    if payload is not None:
        data = json.dumps(payload).encode("utf-8")
        headers["Content-Type"] = "application/json"
    request = urllib.request.Request(url, data=data, headers=headers, method=method.upper())
    with urllib.request.urlopen(request, timeout=timeout) as response:
        body = response.read().decode("utf-8")
        return json.loads(body) if body else {}


def gateway_probe(gateway: str, path: str, timeout: float = 1.0) -> Dict[str, Any]:
    try:
        return {"ok": True, "path": path, "payload": http_json("GET", gateway, path, timeout=timeout)}
    except Exception as exc:
        return {"ok": False, "path": path, "error": str(exc)}


def emit(payload: Dict[str, Any], agent: bool, human: Optional[str] = None) -> None:
    if agent:
        print(json.dumps(payload, sort_keys=True))
    else:
        print(human or json.dumps(payload, indent=2, sort_keys=True))


def bool_value(value: str) -> bool:
    return str(value).strip().lower() not in {"0", "false", "no", "off"}


def read_json_file(path: Optional[str]) -> Dict[str, Any]:
    if not path:
        return {}
    with open(path, "r", encoding="utf-8") as handle:
        return json.load(handle)


def split_items(values: Optional[list[str]]) -> list[str]:
    items: list[str] = []
    for value in values or []:
        for part in str(value).split(","):
            cleaned = part.strip()
            if cleaned:
                items.append(cleaned)
    return items


def forensic_payload_from_args(args: argparse.Namespace) -> Dict[str, Any]:
    return {
        "include_forensic_context": bool_value(getattr(args, "include_forensic_context", "true")),
        "forensic_limit": int(getattr(args, "forensic_limit", 8)),
        "forensic_layer": getattr(args, "forensic_layer", None),
        "forensic_event_kind": getattr(args, "forensic_event_kind", None),
        "forensic_provider": getattr(args, "forensic_provider", None),
        "forensic_status": getattr(args, "forensic_status", None),
    }


def scout_options_from_args(args: argparse.Namespace) -> Dict[str, Any]:
    options = {
        "context_limit": int(getattr(args, "context_limit", 6)),
        "tool_limit": int(getattr(args, "tool_limit", 6)),
        "include_postgres_schema": bool_value(getattr(args, "include_postgres_schema", "false")),
        "include_github_context": bool_value(getattr(args, "include_github_context", "false")),
    }
    options.update(forensic_payload_from_args(args))
    return options


def add_forensic_args(parser: argparse.ArgumentParser) -> None:
    parser.add_argument("--include-forensic-context", default="true", help="true/false")
    parser.add_argument("--forensic-limit", type=int, default=8, help="Bounded L4 forensic result limit")
    parser.add_argument("--forensic-layer", choices=["L1", "L2", "L3", "L4"], help="Filter forensic context by interception layer")
    parser.add_argument("--forensic-event-kind", help="Filter forensic context by event kind")
    parser.add_argument("--forensic-provider", help="Filter forensic context by provider")
    parser.add_argument("--forensic-status", help="Filter forensic context by status")


