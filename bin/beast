def command_configure_intelligence(args: argparse.Namespace) -> Dict[str, Any]:
    """Persist local commons/OTel config and seed privacy-safe commons evidence."""
    from app.kernel.capability_exchange import CapabilityExchange
    from app.kernel.local_config import DEFAULT_ENV_PATH, ensure_signing_key, load_local_env, parse_env_file, write_local_env
    from app.kernel.meta_tool_commons import MetaToolCommons
    from app.kernel.otel_connector import OpenTelemetryConnector

    existing = parse_env_file(DEFAULT_ENV_PATH)
    otel_endpoint = (
        getattr(args, "otel_endpoint", None)
        or os.environ.get("OTEL_EXPORTER_OTLP_ENDPOINT")
        or existing.get("OTEL_EXPORTER_OTLP_ENDPOINT")
        or "http://127.0.0.1:4318"
    )
    exchange_endpoint = (
        getattr(args, "capability_exchange_endpoint", None)
        or os.environ.get("BEAST_CAPABILITY_EXCHANGE_ENDPOINT")
        or existing.get("BEAST_CAPABILITY_EXCHANGE_ENDPOINT")
        or ""
    )
    updates = {
        "OTEL_EXPORTER_OTLP_ENDPOINT": otel_endpoint,
        "OTEL_SERVICE_NAME": getattr(args, "service_name", None) or existing.get("OTEL_SERVICE_NAME") or "edgek-beast-gateway",
        "BEAST_CAPABILITY_EXCHANGE_OPT_IN": "1" if bool_value(getattr(args, "enable_exchange", "true")) else "0",
        "BEAST_CAPABILITY_EXCHANGE_NODE_ID": getattr(args, "node_id", None) or existing.get("BEAST_CAPABILITY_EXCHANGE_NODE_ID") or "local-beast-node",
        "BEAST_CAPABILITY_EXCHANGE_SIGNING_KEY": ensure_signing_key(existing.get("BEAST_CAPABILITY_EXCHANGE_SIGNING_KEY", "")),
    }
    if exchange_endpoint:
        updates["BEAST_CAPABILITY_EXCHANGE_ENDPOINT"] = exchange_endpoint
    merged_env = write_local_env(updates)
    load_local_env(override=True)

    exchange = CapabilityExchange(
        enabled=bool_value(merged_env.get("BEAST_CAPABILITY_EXCHANGE_OPT_IN", "1")),
        endpoint=merged_env.get("BEAST_CAPABILITY_EXCHANGE_ENDPOINT", ""),
    )
    commons = MetaToolCommons(exchange=exchange)
    envelopes = []
    for capability in _commons_seed_capabilities():
        outcome = {
            "task_class": "operator_console",
            "role": "tool_selector",
            "verified": True,
            "useful": True,
            "hidden_clean": True,
            "safe": True,
            "status": "configured",
            "tokens": capability.get("tokens", 0),
            "latency_ms": capability.get("latency_ms", 0),
            "cost_usd": 0,
            "evidence_scope": "local",
        }
        envelopes.append(exchange.prepare(capability, outcome))
    ingest = commons.ingest(envelopes)
    ranking = commons.rank(task_class="operator_console", role="tool_selector", limit=10)
    otel = OpenTelemetryConnector()
    otel_projection = otel.export(
        otel.compile(provider_fitness=[{
            "provider_id": "local",
            "task_class": "operator_console",
            "status": "configured",
            "provider_fitness_score": 1.0,
            "latency_ms": 1,
        }]),
        dry_run=True,
        approved=False,
    )
    return {
        "command": "configure-intelligence",
        "configured": True,
        "env_path": str(DEFAULT_ENV_PATH),
        "restart_required": True,
        "commons": {
            "state": commons.state(),
            "ingest": ingest,
            "ranking_count": ranking.get("count", 0),
            "top_capabilities": [item.get("capability_id") for item in ranking.get("rankings", [])[:5]],
        },
        "capability_exchange": exchange.state(),
        "otel": {
            "state": otel.state(),
            "dry_run_export": {
                "destination": otel_projection.get("destination"),
                "span_count": otel_projection.get("span_count"),
                "reason": otel_projection.get("reason"),
            },
        },
        "next": "Restart the gateway with `./bin/beast --agent up --force-gateway true` so import-time connectors read the new config.",
    }


def command_spaces(args: argparse.Namespace) -> Dict[str, Any]:
    from app.kernel.commons_spaces import (
        MANIFEST_NAME,
        export_space,
        import_space,
        package_tiny_llama_case,
        validate_manifest,
    )

    action = args.spaces_action
    if action == "package-tiny-llama":
        source = Path(args.source).resolve()
        destination = Path(args.output).resolve()
        return {"command": "spaces", "action": action, **package_tiny_llama_case(source, destination)}
    if action == "validate":
        root = Path(args.path).resolve()
        manifest = json.loads((root / MANIFEST_NAME).read_text(encoding="utf-8"))
        return {"command": "spaces", "action": action, **validate_manifest(root, manifest)}
    if action == "export":
        return {
            "command": "spaces",
            "action": action,
            **export_space(Path(args.path).resolve(), Path(args.output).resolve()),
        }
    if action == "import":
        return {
            "command": "spaces",
            "action": action,
            **import_space(
                Path(args.bundle).resolve(),
                Path(args.destination).resolve(),
                approved=bool_value(args.approved),
                dry_run=bool_value(args.dry_run),
            ),
        }
    if action == "replay":
        from app.kernel.commons_space_registry import CommonsSpaceRegistry

        registry = CommonsSpaceRegistry(Path(args.registry).resolve() if args.registry else None)
        return {
            "command": "spaces",
            "action": action,
            **registry.replay(
                args.space_id,
                target=Path(args.target).resolve() if args.target else None,
                deterministic_only=bool_value(args.deterministic_only),
                approved=bool_value(args.approved),
                timeout_seconds=int(args.timeout),
            ),
        }
    if action in {"economy", "economy-proof", "economy-simulate", "credit-issue", "promote-crystal", "prototype-complete"}:
        from app.kernel.commons_economy import ComputeReductionEconomy
        from app.kernel.commons_prototype import CommonsCrystalPromoter, FirstPrototypeRunner
        from app.kernel.commons_space_registry import CommonsSpaceRegistry

        registry = CommonsSpaceRegistry(Path(args.registry).resolve() if args.registry else None)
        economy = ComputeReductionEconomy(registry)
        promoter = CommonsCrystalPromoter(registry, economy)
        if action == "economy":
            result = economy.state()
        elif action == "economy-proof":
            result = economy.proof(args.space_id)
        elif action == "economy-simulate":
            result = economy.simulate(args.space_id)
        elif action == "credit-issue":
            result = economy.issue_credit(
                args.space_id, approved=bool_value(args.approved),
                approved_by=args.approved_by, reason=args.reason or "",
            )
        elif action == "promote-crystal":
            result = promoter.promote(
                args.space_id, approved=bool_value(args.approved),
                approved_by=args.approved_by, reason=args.reason or "",
            )
        else:
            result = FirstPrototypeRunner(registry, economy, promoter).complete(
                space_id=args.space_id,
                target=Path(args.target).resolve(),
                approved=bool_value(args.approved),
                approved_by=args.approved_by,
                reason=args.reason or "",
            )
        return {"command": "spaces", "action": action, **result}
    if action.startswith("federate-"):
        from app.kernel.commons_space_registry import CommonsSpaceRegistry
        from app.kernel.federated_commons import FederatedCommons

        registry = CommonsSpaceRegistry(Path(args.registry).resolve() if args.registry else None)
        federation = FederatedCommons(registry)
        if action == "federate-state":
            return {"command": "spaces", "action": action, **federation.state()}
        if action == "federate-prepare":
            return {
                "command": "spaces", "action": action,
                **federation.prepare(args.space_id, contributor_id=args.contributor_id, ttl_days=int(args.ttl_days)),
            }
        if action == "federate-allow":
            return {
                "command": "spaces", "action": action,
                **federation.allow_contributor(
                    args.contributor_id, public_key_hash=args.public_key_hash,
                    approved=bool_value(args.approved), reason=args.reason or "",
                ),
            }
        if action == "federate-ingest":
            return {
                "command": "spaces", "action": action,
                **federation.ingest(read_json_file(args.envelope), require_allowlisted=bool_value(args.require_allowlisted)),
            }
        if action == "federate-revoke":
            return {
                "command": "spaces", "action": action,
                **federation.revoke(
                    args.envelope_id, approved=bool_value(args.approved),
                    reason=args.reason or "", approved_by=args.approved_by,
                ),
            }
    return {"command": "spaces", "action": action, "error": "unsupported_spaces_action"}


def default_workflow(mode: str) -> Dict[str, Any]:
    digest = hashlib.sha256(f"{mode}_cli_harness".encode("utf-8")).hexdigest()
    workflow: Dict[str, Any] = {
        "beast_object_type": "conductor_workflow_card",
        "version": "1.0",
        "workflow_id": f"wf_{digest[:16]}",
        "task_id": f"tsk_{digest[16:32]}",
        "task_class": f"{mode}_cli_harness",
        "execution_mode": "advisory_plan",
        "executor_binding": {
            "available": True,
            "binding": mode,
            "default": "dry_run" if mode != "zeroclaw" else "planning_only",
        },
        "decision": "ready",
        "steps": [
            {"step_id": "prepare_task", "role": "openclaw", "action": "Build task envelope and gather local context."},
            {"step_id": "pack_context", "role": "cartographer", "action": "Pack memory, route-card, and file evidence."},
            {"step_id": "apply_governance_gates", "role": "sentinel", "action": "Check policy, credentials, circuit, attempts, and logs."},
            {"step_id": "publish_chronicle", "role": "scribe", "action": "Write Chronicle after outcome classification."},
        ],
        "required_gates": [],
        "verification_plan": {
            "required": True,
            "commands": ["pytest -q test_beast_cli_script.py test_beast_cli_executor.py"],
        },
        "chronicle_plan": {
            "required": True,
            "record_type": "cli_harness_outcome",
            "include": ["task_envelope", "provider_diagnostic", "workflow", "verification"],
        },
        "workflow_hash": "sha256:" + digest,
    }
    if mode == "hermes":
        workflow["swarm"] = {
            "used": True,
            "status": "bound",
            "execution_capability": "advisory_read_only",
            "roles": ["planner", "cartographer", "sentinel", "scribe", "verifier"],
        }
    return workflow


def local_executor_result(args: argparse.Namespace, mode: str, execute: bool) -> Dict[str, Any]:
    from app.kernel.beast_cli_executor import BeastCLIExecutor
    from app.kernel.canon_registry import CanonRegistry
    from app.kernel.forensic_memory import ForensicMemory
    from app.kernel.ollama_scout import OllamaScout

    workspace = str(Path(args.workspace or os.environ.get("BEAST_WORKSPACE") or ROOT).resolve())
    workflow = read_json_file(args.workflow) or default_workflow(mode)
    context_packet = read_json_file(args.context)
    insight_packet = getattr(args, "_insight_packet", None)
    executor = BeastCLIExecutor(ollama_scout=OllamaScout(forensic_memory=ForensicMemory()), canon_registry=CanonRegistry())
    objective = args.objective or f"{mode} CLI harness"
    use_ollama = bool_value(args.use_ollama)
    scout_options = scout_options_from_args(args)
    if execute:
        return executor.execute(
            objective=objective,
            workflow=workflow,
            context_packet=context_packet,
            insight_packet=insight_packet,
            mode=mode,
            workspace_root=workspace,
            dry_run=bool_value(args.dry_run),
            approved=bool_value(args.approved),
            use_ollama=use_ollama,
            scout_options=scout_options,
        )
    return executor.plan(
        objective=objective,
        workflow=workflow,
        context_packet=context_packet,
        insight_packet=insight_packet,
        mode=mode,
        workspace_root=workspace,
        use_ollama=use_ollama,
        scout_options=scout_options,
    )


def command_profile(args: argparse.Namespace, mode: str, execute: bool) -> Dict[str, Any]:
    handoff_requested = bool(getattr(args, "handoff", False) or getattr(args, "scope", None) or getattr(args, "success_criteria", None))
    handoff_precheck = None
    if handoff_requested and mode in {"openclaw", "hermes"}:
        handoff_precheck = command_handoff_prepare(args)
        if handoff_precheck.get("ready"):
            setattr(args, "_insight_packet", handoff_precheck.get("insight_packet"))
    payload = {
        "objective": args.objective or f"{mode} CLI harness",
        "mode": mode,
        "workflow": read_json_file(args.workflow) or default_workflow(mode),
        "context_packet": read_json_file(args.context),
        "use_ollama": bool_value(args.use_ollama),
        "scout_options": scout_options_from_args(args),
    }
    if handoff_precheck:
        payload["handoff_precheck"] = handoff_precheck
        if handoff_precheck.get("insight_packet"):
            payload["insight_packet"] = handoff_precheck["insight_packet"]
    if execute:
        payload["dry_run"] = bool_value(args.dry_run)
        payload["approved"] = bool_value(args.approved)
    result: Dict[str, Any]
    if not args.local_only:
        try:
            path = "/edgek/beast-cli/execute" if execute else "/edgek/beast-cli/plan"
            result = http_json("POST", args.gateway, path, payload, timeout=8.0)
        except (urllib.error.URLError, TimeoutError, OSError, ValueError) as exc:
            local = local_executor_result(args, mode, execute)
            result = {**local, "source": "local_fallback", "gateway_error": str(exc)}
    else:
        result = {**local_executor_result(args, mode, execute), "source": "local"}

    if handoff_precheck:
        result["handoff_precheck"] = handoff_precheck
    return result


def add_profile_parser(subparsers: argparse._SubParsersAction, command: str, mode: str, execute: bool) -> None:
    parser = subparsers.add_parser(command, help=f"{'Execute' if execute else 'Plan'} with {mode}")
    parser.set_defaults(handler=lambda args, m=mode, e=execute: command_profile(args, m, e))
    parser.add_argument("--objective", "--task", dest="objective", help="Task objective")
    parser.add_argument("--workflow", help="Path to workflow JSON")
    parser.add_argument("--context", help="Path to context packet JSON")
    parser.add_argument("--use-ollama", default="true", help="true/false")
    parser.add_argument("--context-limit", type=int, default=6)
    parser.add_argument("--tool-limit", type=int, default=6)
    parser.add_argument("--include-postgres-schema", default="false", help="true/false")
    parser.add_argument("--include-github-context", default="false", help="true/false")
    parser.add_argument("--dry-run", default="true", help="true/false")
    parser.add_argument("--approved", default="false", help="true/false")
    parser.add_argument("--local-only", action="store_true", help="Skip gateway and use local executor")
    parser.add_argument("--handoff", action="store_true", help="Attach cloud handoff precheck")
    parser.add_argument("--current-task", help="Path to current task markup JSON")
    parser.add_argument("--scope", help="Required cloud handoff task scope")
    parser.add_argument("--constraint", action="append", help="Current task constraint; repeat or comma-separate")
    parser.add_argument("--success-criteria", action="append", help="Required success criterion; repeat or comma-separate")
    parser.add_argument("--provider", help="Provider filter for local insights")
    parser.add_argument("--task-class", help="Task class filter for local insights")
    parser.add_argument("--limit", type=int, default=8, help="Ranked insight evidence limit")
    parser.add_argument("--persist-task", default="true", help="true/false")
    add_forensic_args(parser)


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description="EdgeK BEAST Local Governor")
    parser.add_argument("--agent", action="store_true", help="Emit machine-readable JSON")
    parser.add_argument("--gateway", default=DEFAULT_GATEWAY, help="BEAST gateway URL")
    parser.add_argument("--workspace", help="Workspace folder path")
    subparsers = parser.add_subparsers(dest="command")

    ui_parser = subparsers.add_parser("ui", help="Launch the BEAST Mission Console TUI")
    ui_parser.add_argument("--workspace", help="Workspace folder path")
    ui_parser.add_argument("--gateway-url", default=DEFAULT_GATEWAY, help="BEAST gateway URL")

    ide_parser = subparsers.add_parser("ide", help="Launch the BEAST Electron IDE with the active workspace")
    ide_parser.add_argument("--workspace", help="Workspace folder path")
    ide_parser.add_argument("--gateway-url", default="", help="Optional BEAST gateway URL override")
    ide_parser.add_argument("--ensure-stack", default="true", help="true/false; preflight gateway, proxy, MCP HTTP, LiteLLM, Ollama, and nginx before opening the IDE")

    up_parser = subparsers.add_parser("up", help="Start BEAST gateway, MCP HTTP, proxy lane, Nginx, LiteLLM, and Ollama")
    up_parser.set_defaults(handler=command_up)
    up_parser.add_argument("--host", default="127.0.0.1")
    up_parser.add_argument("--gateway-port", type=int, default=8101)
    up_parser.add_argument("--mcp-port", type=int, default=8765)
    up_parser.add_argument("--litellm-port", type=int, default=4000)
    up_parser.add_argument("--nginx-port", type=int, default=8080)
    up_parser.add_argument("--ollama-host", default="127.0.0.1:11434")
    up_parser.add_argument("--nginx", default="true", help="true/false; test and start/reload installed nginx")
    up_parser.add_argument("--refresh-surfaces", default="true", help="true/false; refresh MCP/plugin/extension integration files")
    up_parser.add_argument("--install-vscode-extension", default="false", help="true/false; install latest local VSIX with code --install-extension")
    up_parser.add_argument("--force-gateway", default="false", help="true/false; stop managed gateway before starting")

    heal_parser = subparsers.add_parser("heal", help="Kill configured listeners and restart BEAST services")
    heal_parser.set_defaults(handler=command_heal)
    heal_parser.add_argument("--host", default="127.0.0.1")
    heal_parser.add_argument("--gateway-port", type=int, default=8101)
    heal_parser.add_argument("--mcp-port", type=int, default=8765)
    heal_parser.add_argument("--litellm-port", type=int, default=4000)
    heal_parser.add_argument("--nginx-port", type=int, default=8080)
    heal_parser.add_argument("--ollama-host", default="127.0.0.1:11434")
    heal_parser.add_argument("--dry-run", default="false", help="true/false; report recovery actions without changing processes")
    heal_parser.add_argument("--restart-all", default="true", help="true/false; restart the whole stack instead of only unhealthy services")
    heal_parser.add_argument("--kill-address-pids", default="true", help="true/false; kill any process listening on configured service ports before restart")

    start_parser = subparsers.add_parser("start", help="One-command BEAST startup: configure intelligence, refresh clients/plugins, and start services")
    start_parser.set_defaults(handler=command_start)
    start_parser.add_argument("--host", default="127.0.0.1")
    start_parser.add_argument("--gateway-port", type=int, default=8101)
    start_parser.add_argument("--mcp-port", type=int, default=8765)
    start_parser.add_argument("--litellm-port", type=int, default=4000)
    start_parser.add_argument("--nginx-port", type=int, default=8080)
    start_parser.add_argument("--ollama-host", default="127.0.0.1:11434")
    start_parser.add_argument("--nginx", default="true", help="true/false")
    start_parser.add_argument("--refresh-surfaces", default="true", help="true/false")
    start_parser.add_argument("--install-vscode-extension", default="false", help="true/false")
    start_parser.add_argument("--force-gateway", default="true", help="true/false")
    start_parser.add_argument("--configure", default="true", help="true/false; configure commons and OTel before startup")
    start_parser.add_argument("--otel-endpoint", help="OTLP/HTTP base endpoint")
    start_parser.add_argument("--node-id", help="Local capability-exchange node id")
    start_parser.add_argument("--capability-exchange-endpoint", help="Optional remote capability exchange endpoint")

    evidence_parser = subparsers.add_parser("evidence", help="Run compute-governor phase evidence and live provider/model fitness probes")
    evidence_parser.set_defaults(handler=command_evidence)
    evidence_parser.add_argument("--phases", default="1-7", help="Phase selection, e.g. 1-7 or 1,2,6")
    evidence_parser.add_argument("--provider", default="groq", help="Live provider preset for phase 2/3/4/5/7")
    evidence_parser.add_argument("--max-tokens", type=int, default=96)
    evidence_parser.add_argument("--timeout", type=float, default=90.0)
    evidence_parser.add_argument("--command-timeout", type=float, default=240.0)
    evidence_parser.add_argument("--phase1-repeats", type=int, default=20)

    crystal_proof = subparsers.add_parser("crystal-proof", help="Run the sealed three-lane crystallized-compute pilot")
    crystal_proof_sub = crystal_proof.add_subparsers(dest="crystal_proof_action", required=True)
    crystal_proof_run = crystal_proof_sub.add_parser("run", help="Run frontier-native, crystal-only, and crystal-hybrid")
    crystal_proof_run.set_defaults(handler=command_crystal_proof)
    crystal_proof_run.add_argument("--manifest", required=True)
    crystal_proof_run.add_argument("--lanes", default="frontier-native,crystal-only,crystal-hybrid")
    crystal_proof_run.add_argument("--output", required=True)
    crystal_proof_run.add_argument("--private-root")
    evidence_parser.add_argument("--free-live", default="true", help="true/false; run free-provider phase 1/2 live window")
    evidence_parser.add_argument("--free-providers", default="huggingface,groq,cerebras,gemini,openrouter_gptoss")
    evidence_parser.add_argument("--max-providers", type=int, default=2)
    evidence_parser.add_argument("--free-repeats", type=int, default=1)
    evidence_parser.add_argument("--provider-fitness", default="true", help="true/false; run live provider/model fitness benchmark")
    evidence_parser.add_argument("--fitness-tasks", type=int, default=1)
    evidence_parser.add_argument("--fitness-lanes", default="raw,full_beast")
    evidence_parser.add_argument("--fitness-timeout", type=float, default=600.0)
    evidence_parser.add_argument("--fitness-prefix", default="beast_provider_model_fitness_live_free")

    spaces = subparsers.add_parser("spaces", help="Package, validate, export, or import local BEAST Compute Spaces")
    spaces_sub = spaces.add_subparsers(dest="spaces_action", required=True)
    spaces_package = spaces_sub.add_parser("package-tiny-llama", help="Package the Tiny Llama Opus case study")
    spaces_package.set_defaults(handler=command_spaces)
    spaces_package.add_argument(
        "--source",
        default=str(ROOT / "benchmarks" / "results" / "tiny_llama_opus_case_study_qwen25_05b"),
    )
    spaces_package.add_argument(
        "--output",
        default=str(ROOT / "data" / "commons_spaces" / "tiny_llama_opus_gateway_repair"),
    )
    spaces_validate = spaces_sub.add_parser("validate", help="Validate a local Compute Space")
    spaces_validate.set_defaults(handler=command_spaces)
    spaces_validate.add_argument("path")
    spaces_export = spaces_sub.add_parser("export", help="Export a validated local Compute Space bundle")
    spaces_export.set_defaults(handler=command_spaces)
    spaces_export.add_argument("path")
    spaces_export.add_argument("--output", required=True)
    spaces_import = spaces_sub.add_parser("import", help="Preview or import a local Compute Space bundle")
    spaces_import.set_defaults(handler=command_spaces)
    spaces_import.add_argument("bundle")
    spaces_import.add_argument("--destination", default=str(ROOT / "data" / "commons_spaces" / "imports"))
    spaces_import.add_argument("--approved", default="false", help="true/false")
    spaces_import.add_argument("--dry-run", default="true", help="true/false")
    spaces_replay = spaces_sub.add_parser("replay", help="Replay Space integrity or approved local verifiers")
    spaces_replay.set_defaults(handler=command_spaces)
    spaces_replay.add_argument("space_id")
    spaces_replay.add_argument("--registry", help="Local Commons Spaces registry root")
    spaces_replay.add_argument("--target", help="Workspace-local verifier target")
    spaces_replay.add_argument("--deterministic-only", default="true", help="true/false")
    spaces_replay.add_argument("--approved", default="false", help="true/false")
    spaces_replay.add_argument("--timeout", type=int, default=120)
    spaces_economy = spaces_sub.add_parser("economy", help="Show non-financial Compute Reduction Economy state")
    spaces_economy.set_defaults(handler=command_spaces)
    spaces_economy.add_argument("--registry")
    spaces_proof = spaces_sub.add_parser("economy-proof", help="Build reproduced useful-reduction proof")
    spaces_proof.set_defaults(handler=command_spaces)
    spaces_proof.add_argument("space_id")
    spaces_proof.add_argument("--registry")
    spaces_simulate = spaces_sub.add_parser("economy-simulate", help="Simulate non-financial Commons credits")
    spaces_simulate.set_defaults(handler=command_spaces)
    spaces_simulate.add_argument("space_id", nargs="?")
    spaces_simulate.add_argument("--registry")
    spaces_credit = spaces_sub.add_parser("credit-issue", help="Issue one approved non-financial Commons credit")
    spaces_credit.set_defaults(handler=command_spaces)
    spaces_credit.add_argument("space_id")
    spaces_credit.add_argument("--registry")
    spaces_credit.add_argument("--approved", default="false", help="true/false")
    spaces_credit.add_argument("--approved-by", default="operator")
    spaces_credit.add_argument("--reason", default="")
    spaces_promote = spaces_sub.add_parser("promote-crystal", help="Promote a thrice-reproduced Space into advisory Crystal Compute")
    spaces_promote.set_defaults(handler=command_spaces)
    spaces_promote.add_argument("space_id")
    spaces_promote.add_argument("--registry")
    spaces_promote.add_argument("--approved", default="false", help="true/false")
    spaces_promote.add_argument("--approved-by", default="operator")
    spaces_promote.add_argument("--reason", default="")
    spaces_prototype = spaces_sub.add_parser("prototype-complete", help="Complete the approved Tiny Llama first prototype")
    spaces_prototype.set_defaults(handler=command_spaces)
    spaces_prototype.add_argument("--space-id", default="tiny_llama_opus_gateway_repair")
    spaces_prototype.add_argument("--registry")
    spaces_prototype.add_argument("--target", default=str(ROOT))
    spaces_prototype.add_argument("--approved", default="false", help="true/false")
    spaces_prototype.add_argument("--approved-by", default="operator")
    spaces_prototype.add_argument("--reason", default="")
    fed_state = spaces_sub.add_parser("federate-state", help="Show local federation trust state")
    fed_state.set_defaults(handler=command_spaces)
    fed_state.add_argument("--registry")
    fed_prepare = spaces_sub.add_parser("federate-prepare", help="Prepare a signed expiring Space envelope")
    fed_prepare.set_defaults(handler=command_spaces)
    fed_prepare.add_argument("space_id")
    fed_prepare.add_argument("--registry")
    fed_prepare.add_argument("--contributor-id", required=True)
    fed_prepare.add_argument("--ttl-days", type=int, default=30)
    fed_allow = spaces_sub.add_parser("federate-allow", help="Locally allowlist a federation contributor")
    fed_allow.set_defaults(handler=command_spaces)
    fed_allow.add_argument("contributor_id")
    fed_allow.add_argument("--registry")
    fed_allow.add_argument("--approved", default="false", help="true/false")
    fed_allow.add_argument("--public-key-hash", required=True)
    fed_allow.add_argument("--reason", required=True)
    fed_ingest = spaces_sub.add_parser("federate-ingest", help="Ingest a signed envelope as a hypothesis")
    fed_ingest.set_defaults(handler=command_spaces)
    fed_ingest.add_argument("envelope", help="Envelope JSON path")
    fed_ingest.add_argument("--registry")
    fed_ingest.add_argument("--require-allowlisted", default="true", help="true/false")
    fed_revoke = spaces_sub.add_parser("federate-revoke", help="Revoke a federated hypothesis")
    fed_revoke.set_defaults(handler=command_spaces)
    fed_revoke.add_argument("envelope_id")
    fed_revoke.add_argument("--registry")
    fed_revoke.add_argument("--approved", default="false", help="true/false")
    fed_revoke.add_argument("--reason", required=True)
    fed_revoke.add_argument("--approved-by", default="operator")

    gateway_parser = subparsers.add_parser("gateway", help="Start the BEAST FastAPI gateway")
    gateway_parser.add_argument("--host", default="127.0.0.1")
    gateway_parser.add_argument("--port", type=int, default=8101)
    gateway_parser.add_argument("--reload", action="store_true")
    gateway_parser.add_argument("--socket-mode", choices=["direct", "guardian"], default=os.environ.get("BEAST_SOCKET_MODE", "direct"))
    gateway_parser.add_argument("--guardian-service", default="beast")

    commons_gateway_parser = subparsers.add_parser("commons-gateway", help="Start the path-restricted Commons FastAPI gateway")
    commons_gateway_parser.add_argument("--host", default="127.0.0.1")
    commons_gateway_parser.add_argument("--port", type=int, default=8601)
    commons_gateway_parser.add_argument("--socket-mode", choices=["direct", "guardian"], default=os.environ.get("BEAST_SOCKET_MODE", "direct"))

    mcp_parser = subparsers.add_parser("mcp", help="Start the stdio MCP server")
    mcp_parser.add_argument("--workspace", help="Workspace folder path")

    mcp_http_parser = subparsers.add_parser("mcp-http", help="Start the HTTP MCP facade")
    mcp_http_parser.add_argument("--host", default="127.0.0.1")
    mcp_http_parser.add_argument("--port", type=int, default=8765)
    mcp_http_parser.add_argument("--workspace", help="Workspace folder path")

    for name, handler, help_text in [
        ("doctor", command_doctor, "Check gateway, Ollama, secrets, and integrations"),
        ("providers", lambda args: {"command": "providers", "gateway": args.gateway, "exports": provider_exports(args.gateway)}, "Print provider proxy exports"),
        ("integrations", command_integrations, "Report required tool integration readiness"),
        ("compressors", command_compressors, "Report compressor backend readiness"),
        ("mcp-config", command_mcp_config, "Print MCP stdio config"),
        ("mcp-install", command_mcp_install, "Install MCP stdio config into .vscode/mcp.json"),
        ("reinstall-surfaces", command_reinstall_surfaces, "Refresh MCP configs, local plugins, and latest VS Code extension metadata"),
        ("configure-intelligence", command_configure_intelligence, "Configure Meta Tool Commons, local capability exchange, and OTel"),
    ]:
        item = subparsers.add_parser(name, help=help_text)
        item.set_defaults(handler=handler)
        if name in {"mcp-config", "mcp-install"}:
            # Accept the workspace in the natural post-command position while
            # retaining the root-level --workspace form for compatibility.
            item.add_argument("--workspace", default=argparse.SUPPRESS, help="Workspace folder path")
        if name == "reinstall-surfaces":
            item.add_argument("--workspace", help="Workspace folder path")
            item.add_argument("--install-vscode-extension", default="false", help="true/false; install latest local VSIX with code --install-extension")
            item.add_argument("--install-workspace-mcp", default="false", help="true/false; write .vscode/mcp.json fallback")
            item.add_argument("--install-client-mcp", default="true", help="true/false; install Cursor, Claude Code, and Cline-compatible MCP configs")
        if name == "configure-intelligence":
            item.add_argument("--otel-endpoint", help="OTLP/HTTP base endpoint, e.g. http://127.0.0.1:4318")
            item.add_argument("--service-name", default="edgek-beast-gateway")
            item.add_argument("--node-id", help="Local node id to hash into capability exchange contributor identity")
            item.add_argument("--enable-exchange", default="true", help="true/false; enable local signed capability exchange evidence")
            item.add_argument("--capability-exchange-endpoint", help="Optional remote exchange endpoint; local mode works without it")

    compress = subparsers.add_parser("compress", help="Run token pruning/compression")
    compress.set_defaults(handler=command_compress)
    compress.add_argument("--algorithm", default="edgek_prune")
    compress.add_argument("--text")
    compress.add_argument("--file")

    scout = subparsers.add_parser("scout", help="Build local scout packet with ranked chunks, Chronicle memory, L4 context, and fallback recommendations")
    scout.set_defaults(handler=command_scout)
    scout.add_argument("--objective", "--task", dest="objective", required=True, help="Task objective")
    scout.add_argument("--use-ollama", default="false", help="true/false")
    scout.add_argument("--context-limit", type=int, default=6)
    scout.add_argument("--tool-limit", type=int, default=6)
    scout.add_argument("--include-postgres-schema", default="false", help="true/false")
    scout.add_argument("--include-github-context", default="false", help="true/false")
    scout.add_argument("--local-only", action="store_true", help="Skip gateway and use local scout")
    add_forensic_args(scout)

    diagnose = subparsers.add_parser("diagnose", help="Run provider diagnostics")
    diagnose.set_defaults(handler=command_diagnose)
    diagnose.add_argument("--provider", required=True)
    diagnose.add_argument("--objective", "--task", dest="objective")
    diagnose.add_argument("--chronicle", default="true", help="true/false")
    diagnose.add_argument("--local-only", action="store_true", help="Skip gateway and use local builder")

    route = subparsers.add_parser("route", help="Create or refresh a Pathfinder route card")
    route.set_defaults(handler=command_route)
    route.add_argument("--provider", required=True)
    route.add_argument("--objective", "--task", dest="objective")
    route.add_argument("--persist", default="true", help="true/false")
    route.add_argument("--local-only", action="store_true", help="Skip gateway and use local builder")

    verify = subparsers.add_parser("verify", help="Run Quality Cascade checks")
    verify.set_defaults(handler=command_verify)
    verify.add_argument("verify_target", nargs="?", choices=["release-contract"], help="Special verifier target, e.g. release-contract")
    verify.add_argument("--all", action="store_true", help="For release-contract, run structural, parity-foundation, and execution-target checks")
    verify.add_argument("--provider")
    verify.add_argument("--objective", "--task", dest="objective")
    verify.add_argument("--task-class", default="general_software_task")
    verify.add_argument("--local-only", action="store_true", help="Skip gateway and use local builder")

    maintenance = subparsers.add_parser("maintenance", help="Run repo hygiene maintenance checks")
    maintenance.set_defaults(handler=command_maintenance)
    maintenance.add_argument("--run-tests", action="store_true", help="Run full pytest after collect-only checks")
    maintenance.add_argument("--pytest-arg", action="append", help="Pytest argument to use when --run-tests is enabled")
    maintenance.add_argument("--include-extension-checks", default="true", help="true/false")
    maintenance.add_argument("--include-markdown", default="true", help="true/false")
    maintenance.add_argument("--run-packaging", action="store_true", help="Run packaging/build checks such as Python build, Jekyll Docker, dotnet, and Java")
    maintenance.add_argument("--python-version", action="append", help="Python executable to use for package build checks, repeatable")
    maintenance.add_argument("--timeout-seconds", type=int, default=60)
    maintenance.add_argument("--local-only", action="store_true", help="Skip gateway and use local builder")

    chronicle = subparsers.add_parser("chronicle", help="List, inspect, or publish Chronicle projections")
    chronicle.set_defaults(handler=command_chronicle)
    chronicle.add_argument("--task-id")
    chronicle.add_argument("--provider")
    chronicle.add_argument("--task-class")
    chronicle.add_argument("--category")
    chronicle.add_argument("--limit", type=int, default=20)
    chronicle.add_argument("--publish", action="store_true")
    chronicle.add_argument("--target", action="append", help="Projection target; repeat or comma-separate")
    chronicle.add_argument("--approved", default="false", help="true/false")
    chronicle.add_argument("--dry-run", default="true", help="true/false")
    chronicle.add_argument("--local-only", action="store_true", help="Skip gateway and use local Chronicle store")

    promote = subparsers.add_parser("promote", help="Check or promote BEAST skill candidates")
    promote.set_defaults(handler=command_promote)
    promote.add_argument("--candidate-id")
    promote.add_argument("--insight-packet", help="Path to insight packet JSON")
    promote.add_argument("--approved", default="false", help="true/false")
    promote.add_argument("--local-only", action="store_true", help="Return local promotion readiness only")

    prec = subparsers.add_parser("prec", help="Inspect or advance PREC lifecycle state")
    prec_sub = prec.add_subparsers(dest="prec_action", required=True)
    prec_status = prec_sub.add_parser("status", help="Show PREC lifecycle state")
    prec_status.set_defaults(handler=command_prec)
    prec_status.add_argument("--local-only", action="store_true")
    prec_list = prec_sub.add_parser("list", help="List PREC lifecycle records")
    prec_list.set_defaults(handler=command_prec)
    prec_list.add_argument("--kind")
    prec_list.add_argument("--status")
    prec_list.add_argument("--limit", type=int, default=20)
    prec_list.add_argument("--local-only", action="store_true")
    prec_trace = prec_sub.add_parser("trace", help="Show one PREC lifecycle by lifecycle id")
    prec_trace.set_defaults(handler=command_prec)
    prec_trace.add_argument("lifecycle_id")
    prec_trace.add_argument("--local-only", action="store_true")
    prec_snapshot = prec_sub.add_parser("snapshot", help="Build a compact PREC snapshot for handoff/operator review")
    prec_snapshot.set_defaults(handler=command_prec)
    prec_snapshot.add_argument("lifecycle_id")
    prec_snapshot.add_argument("--max-chars", type=int, default=6000)
    prec_snapshot.add_argument("--persist", default="true", help="true/false")
    prec_snapshot.add_argument("--local-only", action="store_true")
    prec_start = prec_sub.add_parser("start", help="Start a PREC lifecycle")
    prec_start.set_defaults(handler=command_prec)
    prec_start.add_argument("--objective", "--task", dest="objective", required=True)
    prec_start.add_argument("--kind", default="operator_session")
    prec_start.add_argument("--scope")
    prec_start.add_argument("--task-id")
    prec_start.add_argument("--provider")
    prec_start.add_argument("--local-only", action="store_true")
    prec_advance = prec_sub.add_parser("advance", help="Append a PREC phase event")
    prec_advance.set_defaults(handler=command_prec)
    prec_advance.add_argument("lifecycle_id")
    prec_advance.add_argument("--phase", required=True, choices=["perceive", "reason", "economize", "crystallize"])
    prec_advance.add_argument("--status", default="completed")
    prec_advance.add_argument("--summary")
    prec_advance.add_argument("--artifacts", help="Path to phase artifact JSON")
    prec_advance.add_argument("--signal", action="append", help="Phase signal; repeat or comma-separate")
    prec_advance.add_argument("--local-only", action="store_true")

    handoff = subparsers.add_parser("handoff-prepare", help="Prepare ranked cloud handoff after current task markup")
    handoff.set_defaults(handler=command_handoff_prepare)
    handoff.add_argument("--objective", "--task", dest="objective", help="Current task objective")
    handoff.add_argument("--current-task", help="Path to current task markup JSON")
    handoff.add_argument("--scope", help="Required cloud handoff task scope")
    handoff.add_argument("--constraint", action="append", help="Current task constraint; repeat or comma-separate")
    handoff.add_argument("--success-criteria", action="append", help="Required success criterion; repeat or comma-separate")
    handoff.add_argument("--provider", help="Provider filter for local insights")
    handoff.add_argument("--task-class", help="Task class filter for local insights")
    handoff.add_argument("--limit", type=int, default=8, help="Ranked insight evidence limit")
    handoff.add_argument("--persist-task", default="true", help="true/false")
    handoff.add_argument("--local-only", action="store_true", help="Skip gateway and use local compiler")
    add_forensic_args(handoff)

    add_profile_parser(subparsers, "openclaw-plan", "openclaw", False)
    add_profile_parser(subparsers, "openclaw-execute", "openclaw", True)
    add_profile_parser(subparsers, "nemoclaw-plan", "nemoclaw", False)
    add_profile_parser(subparsers, "nemoclaw-execute", "nemoclaw", True)
    add_profile_parser(subparsers, "zeroclaw-plan", "zeroclaw", False)
    add_profile_parser(subparsers, "hermes-plan", "hermes", False)
    add_profile_parser(subparsers, "hermes-execute", "hermes", True)
    return parser


def main() -> None:
    parser = build_parser()
    args = parser.parse_args()

    if args.workspace:
        workspace = str(Path(args.workspace).expanduser().resolve())
        os.environ["BEAST_WORKSPACE"] = workspace
        os.environ["BEAST_ACTIVE_WORKSPACE"] = workspace
        os.environ["BEAST_CONTEXT_WORKSPACE"] = workspace

    if args.command == "ui":
        os.environ["BEAST_GATEWAY_URL"] = discover_desktop_gateway(args.gateway_url)
        from app.cli.ui import run

        run()
        return
    if args.command == "ide":
        emit(command_ide(args), args.agent)
        return
    if args.command == "gateway":
        start_gateway(args.host, args.port, args.reload, args.socket_mode, args.guardian_service)
        return
    if args.command == "commons-gateway":
        start_commons_gateway(args.host, args.port, args.socket_mode)
        return
    if args.command == "mcp":
        os.environ["BEAST_GATEWAY_URL"] = discover_desktop_gateway()
        from app.mcp.stdio_server import serve_stdio

        serve_stdio()
        return
    if args.command == "mcp-http":
        start_mcp_http_server(args.host, args.port)
        return

    if not args.command:
        payload = welcome(args)
        emit(payload, args.agent, "EdgeK BEAST CLI\nCommands: " + ", ".join(COMMANDS))
        return

    handler = getattr(args, "handler", None)
    if not handler:
        parser.print_help()
        return
    payload = handler(args)
    emit(payload, args.agent)


if __name__ == "__main__":
    main()
