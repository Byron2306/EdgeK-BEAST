def _phase0_step(name: str, command: list[str], cwd: Path | None = None, timeout: int = 180) -> Dict[str, Any]:
    try:
        completed = subprocess.run(
            command,
            cwd=str(cwd or ROOT),
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            timeout=timeout,
            check=False,
        )
        return {
            "name": name,
            "command": command,
            "cwd": str(cwd or ROOT),
            "ok": completed.returncode == 0,
            "returncode": completed.returncode,
            "stdout": completed.stdout.strip()[-12000:],
            "stderr": completed.stderr.strip()[-8000:],
        }
    except subprocess.TimeoutExpired as exc:
        return {
            "name": name,
            "command": command,
            "cwd": str(cwd or ROOT),
            "ok": False,
            "returncode": 124,
            "stdout": str(exc.stdout or "")[-12000:],
            "stderr": f"timeout after {timeout}s",
        }
    except OSError as exc:
        return {
            "name": name,
            "command": command,
            "cwd": str(cwd or ROOT),
            "ok": False,
            "returncode": 127,
            "stdout": "",
            "stderr": str(exc),
        }


def command_release_contract(args: argparse.Namespace) -> Dict[str, Any]:
    all_checks = bool(getattr(args, "all", False))
    steps = [
        _phase0_step("build_identity", [sys.executable, "scripts/phase0/generate_build_identity.py"], timeout=60),
        _phase0_step("phase0_contracts", [sys.executable, "scripts/phase0/verify_phase0.py"], timeout=90),
    ]
    if all_checks:
        desktop = ROOT / "desktop-ide"
        steps.extend([
            _phase0_step("parity_foundation", ["npm", "run", "smoke:parity:foundation"], cwd=desktop, timeout=240),
            _phase0_step("execution_targets", ["npm", "run", "smoke:targets"], cwd=desktop, timeout=240),
        ])
    steps.append(_phase0_step("release_contract_report", [sys.executable, "scripts/phase0/generate_release_contract.py"], timeout=180))
    status_path = ROOT / "build" / "PHASE0_STATUS.json"
    status: Dict[str, Any] = {}
    if status_path.exists():
        try:
            status = json.loads(status_path.read_text(encoding="utf-8"))
        except (OSError, UnicodeError, json.JSONDecodeError) as exc:
            status = {"status": "FAIL", "error": f"invalid phase0 status artifact: {exc}"}
    ok = all(step.get("ok") for step in steps) and str(status.get("status") or "PASS") == "PASS"
    return {
        "command": "verify release-contract",
        "ok": ok,
        "mode": "all" if all_checks else "structural",
        "status_artifact": str(status_path.relative_to(ROOT)),
        "steps": steps,
        "bundle": status,
    }


def command_verify(args: argparse.Namespace) -> Dict[str, Any]:
    if getattr(args, "verify_target", None) == "release-contract":
        return command_release_contract(args)
    payload = {
