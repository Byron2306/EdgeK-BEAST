def command_doctor(args: argparse.Namespace) -> Dict[str, Any]:
    gateway = gateway_probe(args.gateway, "/health")
    ollama = gateway_probe(args.gateway, "/edgek/ollama/status")
    integrations = gateway_probe(args.gateway, "/edgek/tools/integrations")
    secrets = gateway_probe(args.gateway, "/edgek/providers/secrets")
    ok = gateway["ok"] and integrations["ok"]
    return {
        "command": "doctor",
        "status": "ok" if ok else "attention",
        "gateway": gateway,
        "ollama": ollama,
        "integrations": integrations,
        "secrets": secrets,
        "recommendation": "Start `beast gateway` or inspect integration readiness." if not ok else "Operator surface ready.",
    }


def local_integrations() -> Dict[str, Any]:
    from app.kernel.registry.tool_integrations import RequiredIntegrationRegistry

    return RequiredIntegrationRegistry().status()


def command_integrations(args: argparse.Namespace) -> Dict[str, Any]:
    try:
        payload = http_json("GET", args.gateway, "/edgek/tools/integrations")
        return {"command": "integrations", "source": "gateway", **payload}
    except Exception as exc:
        payload = local_integrations()
        return {"command": "integrations", "source": "local", "gateway_error": str(exc), **payload}


def command_up(args: argparse.Namespace) -> Dict[str, Any]:
    """Start the local BEAST stack as background services."""
    results: list[Dict[str, Any]] = []
    host = str(args.host)
    gateway_port = int(args.gateway_port)
    mcp_port = int(args.mcp_port)
    litellm_port = int(args.litellm_port)
    nginx_port = int(args.nginx_port)
    if bool_value(getattr(args, "force_gateway", "false")):
        results.append(stop_managed_process(run_dir() / "gateway.pid", "gateway"))
        # Force means ownership recovery, not just PID-file cleanup. A stale
        # unmanaged listener otherwise survives and makes `up` report a false
        # healthy state while serving old in-memory code.
        results.append(kill_listeners_on_port("gateway", host, gateway_port, dry_run=False))

    surfaces = command_reinstall_surfaces(argparse.Namespace(
        workspace=str(ROOT),
        install_vscode_extension=getattr(args, "install_vscode_extension", "false"),
    )) if bool_value(getattr(args, "refresh_surfaces", "true")) else {"skipped": True}
    results.append(start_ollama_daemon(host=str(args.ollama_host)))
    results.append(start_litellm_daemon(port=litellm_port))
    results.append(start_gateway_daemon(host=host, port=gateway_port))
    results.append(start_mcp_http_daemon(host=host, port=mcp_port))
    results.append(ensure_nginx(listen_port=nginx_port, apply=bool_value(args.nginx)))

    gateway_base = f"http://{host}:{gateway_port}"
    checks = {
        "gateway": gateway_probe(gateway_base, "/health", timeout=2.0),
        "proxy": gateway_probe(gateway_base, "/proxy/health", timeout=2.0),
        "mcp_gateway": gateway_probe(gateway_base, "/mcp/health", timeout=2.0),
        "mcp_http": {"ok": url_ready(f"http://{host}:{mcp_port}/mcp/health", timeout=2.0), "path": f"http://{host}:{mcp_port}/mcp/health"},
        "litellm": {"ok": url_ready(f"http://127.0.0.1:{litellm_port}/v1/models", timeout=2.0), "path": f"http://127.0.0.1:{litellm_port}/v1/models"},
        "ollama": {"ok": url_ready(f"http://{args.ollama_host}/api/tags", timeout=2.0), "path": f"http://{args.ollama_host}/api/tags"},
        "nginx": {"ok": url_ready(f"http://127.0.0.1:{nginx_port}/health", timeout=2.0), "path": f"http://127.0.0.1:{nginx_port}/health"},
    }
    gateway_routes_ok, gateway_missing = gateway_routes_ready(gateway_base)
    checks["gateway"]["routes_ok"] = gateway_routes_ok
    if gateway_missing:
        checks["gateway"]["missing_routes"] = gateway_missing
    ready = all(check.get("ok") for check in checks.values() if isinstance(check, dict)) and gateway_routes_ok
    return {
        "command": "up",
        "status": "ready" if ready else "attention",
        "gateway": gateway_base,
        "proxy": f"{gateway_base}/proxy",
        "mcp_http": f"http://{host}:{mcp_port}/mcp",
        "litellm": f"http://127.0.0.1:{litellm_port}/v1",
        "ollama": f"http://{args.ollama_host}",
        "nginx": f"http://127.0.0.1:{nginx_port}",
        "services": results,
        "surfaces": surfaces,
        "checks": checks,
        "next": "Run `./bin/beast ui` or `./bin/beast ide` for the desktop workspace.",
    }


def command_ide(args: argparse.Namespace) -> Dict[str, Any]:
    """Launch the Electron IDE with the same workspace and gateway contract."""
    workspace = Path(args.workspace or os.environ.get("BEAST_WORKSPACE") or ROOT).resolve()
    desktop = ROOT / "desktop-ide"
    electron = desktop / "node_modules" / ".bin" / "electron"
    if not desktop.is_dir():
        return {"command": "ide", "ok": False, "error": f"Desktop IDE directory is missing: {desktop}"}
    command = [str(electron), "."] if electron.exists() else ["npm", "start", "--"]
    preferred_gateway = getattr(args, "gateway_url", "") or os.environ.get("BEAST_DESKTOP_GATEWAY", "")
    gateway = discover_desktop_gateway(preferred_gateway)
    gateway_host, gateway_port = parse_host_port(gateway, registry_service_port("beast", 8102))
    if bool_value(getattr(args, "ensure_stack", "true")):
        stack = command_heal(argparse.Namespace(
            host=gateway_host or "127.0.0.1",
            gateway_port=gateway_port,
            mcp_port=registry_service_port("mcp_http", 8765),
            litellm_port=registry_service_port("litellm", 4000),
            nginx_port=registry_service_port("reverse_proxy", 80),
            ollama_host=os.environ.get("OLLAMA_HOST", "127.0.0.1:11434"),
            dry_run="false",
            restart_all="false",
            kill_address_pids="false",
        ))
        gateway = discover_desktop_gateway(preferred_gateway or f"http://{gateway_host}:{gateway_port}")
    env = os.environ.copy()
    env.update({
        "BEAST_WORKSPACE": str(workspace),
        "BEAST_ACTIVE_WORKSPACE": str(workspace),
        "BEAST_CONTEXT_WORKSPACE": str(workspace),
        "BEAST_DESKTOP_GATEWAY": gateway,
        "BEAST_ALLOW_GATEWAY_OVERRIDE": "1",
    })
    try:
        process = subprocess.Popen(command, cwd=str(desktop), env=env, start_new_session=True,
                                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError as exc:
        return {"command": "ide", "ok": False, "error": str(exc), "launch_command": command}
    return {
        "command": "ide",
        "ok": True,
        "pid": process.pid,
        "workspace": str(workspace),
        "gateway": gateway,
        "launch_command": command,
        "stack": stack if bool_value(getattr(args, "ensure_stack", "true")) else {"skipped": True},
    }


def stack_checks(host: str, gateway_port: int, mcp_port: int, litellm_port: int, nginx_port: int, ollama_host: str) -> Dict[str, Dict[str, Any]]:
    gateway_base = f"http://{host}:{gateway_port}"
    return {
        "gateway": gateway_probe(gateway_base, "/health", timeout=2.0),
        "proxy": gateway_probe(gateway_base, "/proxy/health", timeout=2.0),
        "mcp_gateway": gateway_probe(gateway_base, "/mcp/health", timeout=2.0),
        "mcp_http": {"ok": url_ready(f"http://{host}:{mcp_port}/mcp/health", timeout=2.0)},
        "litellm": {"ok": url_ready(f"http://127.0.0.1:{litellm_port}/v1/models", timeout=2.0)},
        "ollama": {"ok": url_ready(f"http://{ollama_host}/api/tags", timeout=2.0)},
        "nginx": {"ok": url_ready(f"http://127.0.0.1:{nginx_port}/health", timeout=2.0), "path": f"http://127.0.0.1:{nginx_port}/health"},
    }


def _atomic_json(path: Path, payload: Dict[str, Any]) -> None:
    temp = path.with_suffix(path.suffix + f".{os.getpid()}.tmp")
    with temp.open("w", encoding="utf-8") as handle:
        json.dump(payload, handle, indent=2, sort_keys=True)
        handle.write("\n")
        handle.flush()
        os.fsync(handle.fileno())
    os.replace(temp, path)


def command_heal(args: argparse.Namespace) -> Dict[str, Any]:
    """Probe the local stack and recover BEAST services.

    By default this is a real reset button: kill listeners on the configured
    service ports, clear stale pid files, and restart the whole local stack.
    Pass --restart-all false for the older selective recovery behavior.
    """
    host = str(args.host)
    gateway_port = int(args.gateway_port)
    mcp_port = int(args.mcp_port)
    litellm_port = int(args.litellm_port)
    nginx_port = int(args.nginx_port)
    ollama_host = str(args.ollama_host)
    ollama_listen_host, ollama_port = parse_host_port(ollama_host, 11434)
    dry_run = bool_value(getattr(args, "dry_run", "false"))
    restart_all = bool_value(getattr(args, "restart_all", "true"))
    kill_address_pids = bool_value(getattr(args, "kill_address_pids", "true"))
    before = stack_checks(host, gateway_port, mcp_port, litellm_port, nginx_port, ollama_host)
    actions: list[Dict[str, Any]] = []

    def stop_known_managed() -> None:
        for service, pid_name in (
            ("gateway", "gateway.pid"),
            ("mcp_http", "mcp-http.pid"),
            ("litellm", "litellm.pid"),
            ("ollama", "ollama.pid"),
        ):
            if dry_run:
                actions.append({"service": service, "status": "would_stop_managed", "pid_file": str(run_dir() / pid_name)})
            else:
                actions.append(stop_managed_process(run_dir() / pid_name, service))

    def kill_known_addresses() -> None:
        for service, listen_host, port in (
            ("gateway", host, gateway_port),
            ("mcp_http", host, mcp_port),
            ("litellm", "127.0.0.1", litellm_port),
            ("nginx", "127.0.0.1", nginx_port),
            ("ollama", ollama_listen_host, ollama_port),
        ):
            actions.append(kill_listeners_on_port(service, listen_host, port, dry_run=dry_run))

    def start_everything() -> None:
        if dry_run:
            for service in ("ollama", "litellm", "gateway", "mcp_http", "nginx"):
                actions.append({"service": service, "status": "would_restart"})
            return
        actions.append(start_ollama_daemon(ollama_host))
        actions.append(start_litellm_daemon(litellm_port))
        actions.append(start_gateway_daemon(host, gateway_port))
        actions.append(start_mcp_http_daemon(host, mcp_port))
        actions.append(ensure_nginx(nginx_port, apply=True))

    if restart_all:
        stop_known_managed()
        if kill_address_pids:
            kill_known_addresses()
        start_everything()
        after = before if dry_run else stack_checks(host, gateway_port, mcp_port, litellm_port, nginx_port, ollama_host)
        ready = all(item.get("ok") for item in after.values())
        payload = {
            "command": "heal",
            "mode": "full_restart",
            "status": "dry_run" if dry_run else "healed" if ready else "attention",
            "before": before,
            "actions": actions,
            "after": after,
            "changed": bool(actions),
            "timestamp": time.time(),
        }
        if not dry_run:
            _atomic_json(run_dir() / "heal-report.json", payload)
        return payload

    def recover(name: str, starter: Any, pid_name: Optional[str] = None) -> None:
        if before.get(name, {}).get("ok"):
            return
        if dry_run:
            actions.append({"service": name, "status": "would_restart"})
            return
        if pid_name:
            actions.append(stop_managed_process(run_dir() / pid_name, name))
        actions.append(starter())

    recover("ollama", lambda: start_ollama_daemon(ollama_host), "ollama.pid")
    recover("litellm", lambda: start_litellm_daemon(litellm_port), "litellm.pid")
    gateway_failed = any(not before.get(name, {}).get("ok") for name in ("gateway", "proxy", "mcp_gateway"))
    if gateway_failed:
        if dry_run:
            actions.append({"service": "gateway", "status": "would_restart"})
        else:
            actions.append(stop_managed_process(run_dir() / "gateway.pid", "gateway"))
            actions.append(start_gateway_daemon(host, gateway_port))
    recover("mcp_http", lambda: start_mcp_http_daemon(host, mcp_port), "mcp-http.pid")
    if not before.get("nginx", {}).get("ok"):
        actions.append({"service": "nginx", "status": "would_repair"} if dry_run else ensure_nginx(nginx_port, apply=True))

    after = before if dry_run else stack_checks(host, gateway_port, mcp_port, litellm_port, nginx_port, ollama_host)
    ready = all(item.get("ok") for item in after.values())
    payload = {
        "command": "heal",
        "status": "dry_run" if dry_run else "healed" if ready else "attention",
        "before": before,
        "actions": actions,
        "after": after,
        "changed": bool(actions),
        "timestamp": time.time(),
    }
    if not dry_run:
        _atomic_json(run_dir() / "heal-report.json", payload)
    return payload


def command_start(args: argparse.Namespace) -> Dict[str, Any]:
    """One-command startup for daily BEAST operation."""
    configure = command_configure_intelligence(argparse.Namespace(
        otel_endpoint=getattr(args, "otel_endpoint", None),
        service_name="edgek-beast-gateway",
        node_id=getattr(args, "node_id", None),
        enable_exchange="true",
        capability_exchange_endpoint=getattr(args, "capability_exchange_endpoint", None),
    )) if bool_value(getattr(args, "configure", "true")) else {"skipped": True}
    up = command_up(argparse.Namespace(
        host=getattr(args, "host", "127.0.0.1"),
        gateway_port=getattr(args, "gateway_port", 8101),
        mcp_port=getattr(args, "mcp_port", 8765),
        litellm_port=getattr(args, "litellm_port", 4000),
        nginx_port=getattr(args, "nginx_port", 8080),
        ollama_host=getattr(args, "ollama_host", "127.0.0.1:11434"),
        nginx=getattr(args, "nginx", "true"),
        refresh_surfaces=getattr(args, "refresh_surfaces", "true"),
        install_vscode_extension=getattr(args, "install_vscode_extension", "false"),
        force_gateway=getattr(args, "force_gateway", "true"),
    ))
    return {
        "command": "start",
        "status": up.get("status"),
        "configure_intelligence": configure,
        "up": up,
        "next": "Open the TUI with `./bin/beast ui` or use the installed MCP server from your agent client.",
    }


def _run_evidence_command(label: str, command: list[str], timeout_seconds: float) -> Dict[str, Any]:
    started = time.time()
    completed = subprocess.run(
        command,
        cwd=str(ROOT),
        capture_output=True,
        text=True,
        timeout=timeout_seconds,
        check=False,
    )
    return {
        "label": label,
        "command": command,
        "returncode": completed.returncode,
        "passed": completed.returncode == 0,
        "duration_ms": round((time.time() - started) * 1000.0, 3),
        "stdout_tail": completed.stdout[-4000:],
        "stderr_tail": completed.stderr[-4000:],
    }


def _parse_phase_selection(value: str) -> list[int]:
    selected: set[int] = set()
    for part in str(value or "1-7").split(","):
        part = part.strip()
        if not part:
            continue
        if "-" in part:
            start, end = part.split("-", 1)
            selected.update(range(int(start), int(end) + 1))
        else:
            selected.add(int(part))
    return [phase for phase in sorted(selected) if 1 <= phase <= 7]


def _write_model_fitness_from_benchmark(prefix: str) -> Optional[Dict[str, Any]]:
    report_path = ROOT / "benchmarks" / "results" / f"{prefix}.json"
    if not report_path.exists():
        return None
    report = json.loads(report_path.read_text(encoding="utf-8"))
    presets = report.get("live_provider_presets") or {}
    rows: Dict[str, Dict[str, Any]] = {}
    for item in report.get("live_results") or []:
        provider = str(item.get("provider") or "custom")
        model = str((presets.get(provider) or {}).get("model") or provider)
        key = f"{provider}::{model}"
        row = rows.setdefault(key, {
            "provider": provider,
            "model": model,
            "samples": 0,
            "completed": 0,
            "clean_completed": 0,
            "rescued_completed": 0,
            "provider_responses": 0,
            "provider_completed": 0,
            "provider_clean_completed": 0,
            "provider_rescued_completed": 0,
            "system_rescued_completed": 0,
            "endpoint_failures": 0,
            "endpoint_errors": [],
            "latency_ms": [],
            "total_tokens": 0,
            "lanes": {},
        })
        evidence = item.get("output_evidence") or {}
        completed = bool(item.get("completed"))
        rescued = bool(evidence.get("canonicalized") or evidence.get("repair_attempted") or evidence.get("local_verifier_repair"))
        usage = item.get("usage") or {}
        provider_response = bool(item.get("provider_text_excerpt") or usage or item.get("latency_ms") is not None)
        initial_error = str(evidence.get("initial_validation_error") or "")
        endpoint_failure = bool(initial_error and not provider_response)
        row["samples"] += 1
        row["completed"] += int(completed)
        row["clean_completed"] += int(completed and not rescued)
        row["rescued_completed"] += int(completed and rescued)
        row["provider_responses"] += int(provider_response)
        row["provider_completed"] += int(completed and provider_response)
        row["provider_clean_completed"] += int(completed and provider_response and not rescued)
        row["provider_rescued_completed"] += int(completed and provider_response and rescued)
        row["system_rescued_completed"] += int(completed and rescued and not provider_response)
        row["endpoint_failures"] += int(endpoint_failure)
        if endpoint_failure and initial_error and initial_error not in row["endpoint_errors"]:
            row["endpoint_errors"].append(initial_error[:500])
        if item.get("latency_ms") is not None:
            row["latency_ms"].append(float(item.get("latency_ms") or 0))
        row["total_tokens"] += int(usage.get("total_tokens") or usage.get("prompt_tokens") or 0) + int(usage.get("completion_tokens") or 0)
        lane = str(item.get("lane") or "unknown")
        lane_row = row["lanes"].setdefault(lane, {"samples": 0, "completed": 0})
        lane_row["samples"] += 1
        lane_row["completed"] += int(completed)
    model_rows = []
    for row in rows.values():
        samples = max(1, int(row["samples"]))
        completion_rate = row["provider_completed"] / samples
        clean_rate = row["provider_clean_completed"] / samples
        rescue_rate = row["provider_rescued_completed"] / samples
        response_rate = row["provider_responses"] / samples
        avg_latency = sum(row["latency_ms"]) / len(row["latency_ms"]) if row["latency_ms"] else None
        score = round(
            (0.50 * clean_rate)
            + (0.25 * completion_rate)
            + (0.15 * response_rate)
            + (0.10 * max(0.0, 1.0 - rescue_rate))
            if row["provider_responses"]
            else 0.0,
            6,
        )
        model_rows.append({
            **{key: value for key, value in row.items() if key != "latency_ms"},
            "completion_rate": round(completion_rate, 6),
            "clean_completion_rate": round(clean_rate, 6),
            "rescue_rate": round(rescue_rate, 6),
            "provider_response_rate": round(response_rate, 6),
            "avg_latency_ms": round(avg_latency, 3) if avg_latency is not None else None,
            "fitness_score": score,
        })
    model_rows.sort(key=lambda item: item["fitness_score"], reverse=True)
    payload = {
        "beast_object_type": "provider_model_fitness_snapshot",
        "version": "1.0",
        "source_report": str(report_path),
        "models": model_rows,
        "count": len(model_rows),
    }
    out = ROOT / "benchmarks" / "results" / f"{prefix}_model_fitness.json"
    out.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    md = ROOT / "benchmarks" / "results" / f"{prefix}_model_fitness.md"
    lines = [
        "# Live Provider Model Fitness",
        "",
        "| Provider | Model | Score | Responses | Provider completed | Clean | Provider rescued | System rescued | Endpoint failures | Avg latency ms | Tokens |",
        "| --- | --- | ---: | ---: | ---: | ---: | ---: | ---: | ---: | ---: | ---: |",
    ]
    for row in model_rows:
        lines.append(
            f"| `{row['provider']}` | `{row['model']}` | {row['fitness_score']} | {row['provider_responses']}/{row['samples']} | "
            f"{row['provider_completed']} | {row['provider_clean_completed']} | {row['provider_rescued_completed']} | "
            f"{row['system_rescued_completed']} | {row['endpoint_failures']} | {row['avg_latency_ms']} | {row['total_tokens']} |"
        )
    md.write_text("\n".join(lines) + "\n", encoding="utf-8")
    return {"json": str(out), "markdown": str(md), "count": len(model_rows)}


def command_evidence(args: argparse.Namespace) -> Dict[str, Any]:
    """Run bounded compute-governor and live provider/model evidence windows."""
    phases = _parse_phase_selection(getattr(args, "phases", "1-7"))
    provider = getattr(args, "provider", "groq")
    max_tokens = str(int(getattr(args, "max_tokens", 96)))
    timeout = str(float(getattr(args, "timeout", 90.0)))
    py = beast_python()
    phase_scripts = {
        1: [py, "benchmarks/compute_governor_phase1_calibration.py", "--repeats", str(int(getattr(args, "phase1_repeats", 20)))],
        2: [py, "benchmarks/compute_governor_phase2_live_displacement.py", "--provider", provider, "--max-tokens", max_tokens, "--timeout", timeout],
        3: [py, "benchmarks/compute_governor_phase3_live_false_reuse.py", "--provider", provider, "--max-tokens", max_tokens, "--timeout", timeout],
        4: [py, "benchmarks/compute_governor_phase4_groq_routing.py", "--provider", provider, "--max-tokens", max_tokens, "--timeout", timeout],
        5: [py, "benchmarks/compute_governor_phase5_groq_streaming.py", "--provider", provider, "--max-tokens", max_tokens, "--timeout", timeout],
        6: [py, "benchmarks/compute_governor_phase6_lifecycle.py"],
        7: [py, "benchmarks/compute_governor_phase7_runtime_reuse.py", "--provider", provider, "--max-tokens", max_tokens, "--timeout", timeout],
    }
    results = []
    for phase in phases:
        results.append(_run_evidence_command(f"phase{phase}", phase_scripts[phase], float(getattr(args, "command_timeout", 240.0))))

    free_live = None
    if bool_value(getattr(args, "free_live", "true")):
        free_live = _run_evidence_command(
            "free_live_phase1_2",
            [
                py, "benchmarks/compute_governor_free_live.py",
                "--providers", getattr(args, "free_providers", "huggingface,groq,cerebras,gemini,openrouter_gptoss"),
                "--max-providers", str(int(getattr(args, "max_providers", 2))),
                "--repeats", str(int(getattr(args, "free_repeats", 1))),
                "--max-tokens", max_tokens,
                "--timeout", timeout,
            ],
            float(getattr(args, "command_timeout", 240.0)),
        )
        results.append(free_live)

    provider_model_fitness = None
    prefix = getattr(args, "fitness_prefix", "beast_provider_model_fitness_live_free")
    if bool_value(getattr(args, "provider_fitness", "true")):
        fitness = _run_evidence_command(
            "provider_model_fitness",
            [
                py, "benchmarks/beast_systems_benchmark.py",
                "--live-agent",
                "--live-provider", getattr(args, "free_providers", "huggingface,groq,cerebras,gemini,openrouter_gptoss"),
                "--live-only",
                "--live-max-tasks", str(int(getattr(args, "fitness_tasks", 1))),
                "--live-max-tokens", max_tokens,
                "--live-timeout", timeout,
                "--live-lanes", getattr(args, "fitness_lanes", "raw,full_beast"),
                "--live-prompt-mode", "compact",
                "--live-json-mode",
                "--output-prefix", prefix,
            ],
            float(getattr(args, "fitness_timeout", 600.0)),
        )
        results.append(fitness)
        provider_model_fitness = _write_model_fitness_from_benchmark(prefix)

    passed = all(item.get("passed") for item in results)
    return {
        "command": "evidence",
        "status": "passed" if passed else "attention",
        "phases": phases,
        "provider": provider,
        "results": results,
        "provider_model_fitness": provider_model_fitness,
        "artifacts": sorted(str(path) for path in (ROOT / "benchmarks" / "results").glob("compute_governor_phase*.json")),
    }


def command_crystal_proof(args: argparse.Namespace) -> Dict[str, Any]:
    from app.kernel.compute.crystal_proof_conductor import CrystalProofConductor
    lanes = tuple(item.strip().replace("-", "_") for item in str(args.lanes).split(",") if item.strip())
    return CrystalProofConductor().run(
        Path(args.manifest), lanes=lanes, output=Path(args.output),
        private_root=Path(args.private_root) if args.private_root else None,
    )


def command_compressors(args: argparse.Namespace) -> Dict[str, Any]:
    status = command_integrations(args)
    compressors = status.get("compressors")
    if not isinstance(compressors, dict) or "backends" not in compressors:
        compressors = local_integrations().get("compressors", {})
    return {
        "command": "compressors",
        "source": status.get("source"),
        "compressors": compressors,
        "gateway_error": status.get("gateway_error"),
    }


def command_compress(args: argparse.Namespace) -> Dict[str, Any]:
    from app.kernel.tool_integrations import ToolCallInterceptor

    text = args.text
    if args.file:
        text = Path(args.file).read_text(encoding="utf-8", errors="replace")
    if text is None:
        text = sys.stdin.read()
    result = ToolCallInterceptor().compress_text(text or "", algorithm=args.algorithm)
    return {"command": "compress", **result}


def _gateway_or_local(args: argparse.Namespace, method: str, path: str, payload: Optional[Dict[str, Any]], local_fn, timeout: float = 8.0) -> Dict[str, Any]:
    if not getattr(args, "local_only", False):
        try:
            result = http_json(method, args.gateway, path, payload, timeout=timeout)
            return {"source": "gateway", **result}
        except (urllib.error.URLError, TimeoutError, OSError, ValueError) as exc:
            local = local_fn(exc)
            return {**local, "source": "local_fallback", "gateway_error": str(exc)}
    return {**local_fn(None), "source": "local"}


def _authority_receipt(name: str, *, phase: str, risk: str = "low", category: str = "planning") -> Dict[str, Any]:
    """Attach the same non-mutating authority receipt used by IDE/TUI/MCP."""
    from app.kernel.execution.least_authority_tools import LeastAuthorityToolLoop
    return LeastAuthorityToolLoop().plan(
        [{"name": f"cli:{name}", "category": category, "bucket": "Verify" if phase == "verify" else "Reason", "mutating": False}],
        phase=phase, risk=risk,
    )


