        "user_request": args.objective or "Run local quality cascade",
        "task_class": args.task_class,
    }

    def local(_exc):
        from app.kernel.task_envelope import TaskEnvelopeBuilder

        return TaskEnvelopeBuilder().run_quality_cascade(payload, workspace_root=str(ROOT))

    return {"command": "verify", "authority": _authority_receipt("verify", phase="verify", category="audit"), **_gateway_or_local(args, "POST", "/edgek/quality/run", payload, local)}


