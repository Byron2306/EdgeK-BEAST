# References only: never commit actual credentials.
# L2 source chunks are allowed only in the local LanceDB projection.
# Cloud stores never receive workspace source, prompts, diffs, or logs.
BEAST_VECTOR_MEMORY_LOCAL_PROJECTION_ENABLED=1
# L3 verified skills / L4 sanitized forensic summaries need their own opt-in.
BEAST_VECTOR_MEMORY_CLOUD_OPERATIONAL_ENABLED=0
BEAST_PGVECTOR_DSN=postgresql://beast:CHANGE_ME@127.0.0.1:5432/beast
BEAST_QDRANT_URL=https://your-cluster.cloud.qdrant.io
BEAST_QDRANT_API_KEY=CHANGE_ME
BEAST_CHROMA_API_KEY=CHANGE_ME
BEAST_CHROMA_TENANT=your-tenant
BEAST_CHROMA_DATABASE=beast
BEAST_LANCEDB_URI=.beast/lancedb
