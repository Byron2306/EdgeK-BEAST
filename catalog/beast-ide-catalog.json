{
  "beast_object_type": "beast_ide_catalog",
  "version": "1.0",
  "note": "Curated, advisory catalog of genuinely useful MCP servers, CLI tools, and editor extensions. MCP servers can be registered with the BEAST broker (policy-gated) and/or copied into an mcp client config. Tools are detected via PATH. Nothing here auto-installs or executes; installs remain operator-approved.",
  "mcp_servers": [
    {
      "id": "filesystem",
      "name": "Filesystem",
      "description": "Bounded read/list/search over an allowlisted local directory.",
      "category": "context",
      "transport": "stdio",
      "runner": "npx",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "${workspaceRoot}"],
      "env": {},
      "risk_class": "low",
      "server_class": "local_read_only",
      "homepage": "https://github.com/modelcontextprotocol/servers/tree/main/src/filesystem"
    },
    {
      "id": "git",
      "name": "Git",
      "description": "Read repository status, diffs, logs, and blame for the workspace.",
      "category": "vcs",
      "transport": "stdio",
      "runner": "uvx",
      "command": "uvx",
      "args": ["mcp-server-git", "--repository", "${workspaceRoot}"],
      "env": {},
      "risk_class": "medium",
      "server_class": "shell",
      "homepage": "https://github.com/modelcontextprotocol/servers/tree/main/src/git"
    },
    {
      "id": "github",
      "name": "GitHub",
      "description": "Issues, PRs, code search, and repo metadata via the GitHub API.",
      "category": "vcs",
      "transport": "stdio",
      "runner": "npx",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {"GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}"},
      "risk_class": "medium",
      "server_class": "github",
      "homepage": "https://github.com/modelcontextprotocol/servers/tree/main/src/github"
    },
    {
      "id": "fetch",
      "name": "Fetch",
      "description": "Fetch a URL and return readable content for grounding/RAG.",
      "category": "web",
      "transport": "stdio",
      "runner": "uvx",
      "command": "uvx",
      "args": ["mcp-server-fetch"],
      "env": {},
      "risk_class": "medium",
      "server_class": "network",
      "homepage": "https://github.com/modelcontextprotocol/servers/tree/main/src/fetch"
    },
    {
      "id": "sqlite",
      "name": "SQLite",
      "description": "Query and inspect a local SQLite database.",
      "category": "data",
      "transport": "stdio",
      "runner": "uvx",
      "command": "uvx",
      "args": ["mcp-server-sqlite", "--db-path", "${workspaceRoot}/data/beast.db"],
      "env": {},
      "risk_class": "medium",
      "server_class": "database",
      "homepage": "https://github.com/modelcontextprotocol/servers/tree/main/src/sqlite"
    },
    {
      "id": "postgres",
      "name": "PostgreSQL",
      "description": "Read-only SQL over a Postgres DSN (schema introspection + queries).",
      "category": "data",
      "transport": "stdio",
      "runner": "npx",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-postgres", "${POSTGRES_DSN}"],
      "env": {},
      "risk_class": "high",
      "server_class": "postgres",
      "homepage": "https://github.com/modelcontextprotocol/servers/tree/main/src/postgres"
    },
    {
      "id": "memory",
      "name": "Knowledge Graph Memory",
      "description": "Persistent knowledge-graph memory across sessions.",
      "category": "memory",
      "transport": "stdio",
      "runner": "npx",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-memory"],
      "env": {},
      "risk_class": "low",
      "server_class": "local_write",
      "homepage": "https://github.com/modelcontextprotocol/servers/tree/main/src/memory"
    },
    {
      "id": "sequential-thinking",
      "name": "Sequential Thinking",
      "description": "Structured step-by-step reasoning scratchpad tool.",
      "category": "reasoning",
      "transport": "stdio",
      "runner": "npx",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-sequential-thinking"],
      "env": {},
      "risk_class": "low",
      "server_class": "local_read_only",
      "homepage": "https://github.com/modelcontextprotocol/servers/tree/main/src/sequentialthinking"
    },
    {
      "id": "playwright",
      "name": "Playwright Browser",
      "description": "Drive a headless browser for scraping, testing, and screenshots.",
      "category": "web",
      "transport": "stdio",
      "runner": "npx",
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"],
      "env": {},
      "risk_class": "high",
      "server_class": "network",
      "homepage": "https://github.com/microsoft/playwright-mcp"
    }
  ],
  "tools": [
    {"id": "ripgrep", "name": "ripgrep", "detect": "rg", "category": "search", "description": "Extremely fast recursive code search.", "install_hint": "apt install ripgrep | brew install ripgrep", "homepage": "https://github.com/BurntSushi/ripgrep"},
    {"id": "fd", "name": "fd", "detect": "fd", "category": "search", "description": "Fast, user-friendly file finder.", "install_hint": "apt install fd-find | brew install fd", "homepage": "https://github.com/sharkdp/fd"},
    {"id": "jq", "name": "jq", "detect": "jq", "category": "data", "description": "Command-line JSON processor.", "install_hint": "apt install jq | brew install jq", "homepage": "https://jqlang.github.io/jq/"},
    {"id": "gh", "name": "GitHub CLI", "detect": "gh", "category": "vcs", "description": "GitHub from the terminal (PRs, issues, releases).", "install_hint": "https://cli.github.com", "homepage": "https://cli.github.com"},
    {"id": "uv", "name": "uv", "detect": "uv", "category": "python", "description": "Fast Python package/venv manager; provides uvx for MCP servers.", "install_hint": "curl -LsSf https://astral.sh/uv/install.sh | sh", "homepage": "https://github.com/astral-sh/uv"},
    {"id": "ruff", "name": "Ruff", "detect": "ruff", "category": "python", "description": "Fast Python linter + formatter.", "install_hint": "uv tool install ruff | pip install ruff", "homepage": "https://docs.astral.sh/ruff/"},
    {"id": "docker", "name": "Docker", "detect": "docker", "category": "runtime", "description": "Containers for reproducible builds and sandboxed execution.", "install_hint": "https://docs.docker.com/get-docker/", "homepage": "https://www.docker.com"},
    {"id": "pnpm", "name": "pnpm", "detect": "pnpm", "category": "node", "description": "Fast, disk-efficient Node package manager.", "install_hint": "npm install -g pnpm", "homepage": "https://pnpm.io"}
  ],
  "vscode_extensions": [
    {"id": "ms-python.python", "name": "Python", "category": "language", "description": "Python language support, debugging, and environments.", "marketplace": "https://marketplace.visualstudio.com/items?itemName=ms-python.python"},
    {"id": "charliermarsh.ruff", "name": "Ruff", "category": "lint", "description": "Ruff linter/formatter integration.", "marketplace": "https://marketplace.visualstudio.com/items?itemName=charliermarsh.ruff"},
    {"id": "eamodio.gitlens", "name": "GitLens", "category": "vcs", "description": "Supercharged Git blame, history, and visualization.", "marketplace": "https://marketplace.visualstudio.com/items?itemName=eamodio.gitlens"},
    {"id": "ms-azuretools.vscode-docker", "name": "Docker", "category": "runtime", "description": "Build, manage, and debug containerized apps.", "marketplace": "https://marketplace.visualstudio.com/items?itemName=ms-azuretools.vscode-docker"},
    {"id": "tamasfe.even-better-toml", "name": "Even Better TOML", "category": "language", "description": "TOML syntax + schema validation (pyproject.toml).", "marketplace": "https://marketplace.visualstudio.com/items?itemName=tamasfe.even-better-toml"}
  ]
}
